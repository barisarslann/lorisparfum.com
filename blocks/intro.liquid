{% liquid
  assign bg_rgb = block.settings.background_color | color_to_rgb
  assign text_rgb = block.settings.text_color | color_to_rgb
%}
<style>
  [data-block-id="{{ block.id }}"] {
    {% if block.settings.background_color != blank and block.settings.background_color != 'transparent' and bg_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --quiz-intro-overlay-rgb: {{ bg_rgb | remove: 'rgb(' | remove: ')' }};
    {% endif %}
    {% if block.settings.text_color != blank and block.settings.text_color != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --quiz-block-text: {{ block.settings.text_color }};
      --color-custom-text: {{ block.settings.text_color }};
    {% endif %}
    --quiz-intro-overlay-opacity: {{ block.settings.color-overlay-opacity | divided_by: 100.0 }};
    --quiz-height-mobile: {{ block.settings.mobile_fixed_height }}px;
    --quiz-height-desktop: {{ block.settings.desktop_fixed_height }}px;
    --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};
    --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};
  }
</style>


{%- if block.settings.style == 'banner' -%}
  <div class="wt-quiz__intro--banner" data-block-type="intro" data-height="{{ block.settings.height_mode }}">
    {%- render 'hero',
      desktop_image: block.settings.desktop_image,
      mobile_image: block.settings.mobile_image,
      video: block.settings.desktop_video,
      mobile_video: block.settings.mobile_video,
      desktop_text_horizontal_position: block.settings.desktop_text_horizontal_position,
      desktop_text_vertical_position: block.settings.desktop_text_vertical_position,
      mobile_text_horizontal_position: block.settings.mobile_text_horizontal_position,
      mobile_text_vertical_position: block.settings.mobile_text_vertical_position,
      placeholder: 'hero-apparel-1',
      subheading: block.settings.subheading,
      heading: block.settings.heading,
      text: block.settings.body,
      button_label: block.settings.button_label,
      button_link: '#',
      button_select: block.settings.button_select,
      lcp_tweak: true
    -%}
  </div>
{%- else -%}
  {%- if block.settings.layout == 'text_first' -%}
    {%- assign customclass = 'hero--grid hero--grid--rev' -%}
  {%- else -%}
    {%- assign customclass = 'hero--grid' -%}
  {%- endif -%}
  <div class="wt-quiz__intro--image_with_text" data-block-type="intro" data-height="{{ block.settings.height_mode }}">
    {%- render 'hero',
      classname: customclass,
      desktop_image: block.settings.desktop_image,
      mobile_image: block.settings.mobile_image,
      video: block.settings.desktop_video,
      mobile_video: block.settings.mobile_video,
      desktop_text_horizontal_position: block.settings.desktop_text_horizontal_position,
      desktop_text_vertical_position: block.settings.desktop_text_vertical_position,
      mobile_text_horizontal_position: block.settings.mobile_text_horizontal_position,
      mobile_text_vertical_position: block.settings.mobile_text_vertical_position,
      placeholder: 'hero-apparel-1',
      subheading: block.settings.subheading,
      heading: block.settings.heading,
      text: block.settings.body,
      button_label: block.settings.button_label,
      button_link: '#',
      button_select: block.settings.button_select,
      lcp_tweak: true
    -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.quiz.blocks.intro.name",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.quiz.blocks.intro.settings.style.label",
      "options": [
        {"value": "banner", "label": "t:sections.quiz.blocks.intro.settings.style.options.banner.label"},
        {"value": "image_with_text", "label": "t:sections.quiz.blocks.intro.settings.style.options.image_with_text.label"}
      ],
      "default": "banner"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {"value": "image_first", "label": "t:sections.image-with-text.settings.layout.options__1.label"},
        {"value": "text_first", "label": "t:sections.image-with-text.settings.layout.options__2.label"}
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label",
      "info": "t:sections.image-with-text.settings.layout.info",
      "visible_if": "{{ block.settings.style == 'image_with_text' }}"
    },
    {
      "type": "header",
      "content": "t:sections.global.section-height"
    },
    {
      "type": "radio",
      "id": "height_mode",
      "label": "t:sections.slideshow.settings.slide.slide_height.default.label",
      "options": [
        {"value": "adapt", "label": "t:sections.quiz.settings.height_mode.adapt.label"},
        {"value": "fixed_height", "label": "t:sections.slideshow.settings.slide.slide_height.fixed_height.label"}
      ],
      "default": "fixed_height"
    },
    {
      "type": "range",
      "id": "desktop_fixed_height",
      "min": 300,
      "max": 1000,
      "unit": "px",
      "step": 20,
      "default": 320,
      "label": "t:sections.slideshow.settings.slide.desktop_fixed_height.label",
      "visible_if": "{{ block.settings.height_mode == 'fixed_height' }}"
    },
    {
      "type": "range",
      "id": "mobile_fixed_height",
      "min": 300,
      "max": 1000,
      "unit": "px",
      "step": 20,
      "default": 460,
      "label": "t:sections.slideshow.settings.slide.mobile_fixed_height.label",
      "visible_if": "{{ block.settings.height_mode == 'fixed_height' }}"
    },
    {
      "type": "header",
      "content": "t:sections.global.desktop_version"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "t:sections.logo-banner.settings.video-hosted.label"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:sections.quiz.blocks.intro.settings.image.label"
    },
    {
      "type": "select",
      "id": "desktop_text_vertical_position",
      "options": [
        {"value": "top", "label": "t:sections.image-banner.settings.desktop_text_vertical_position.top.label"},
        {"value": "center", "label": "t:sections.image-banner.settings.desktop_text_vertical_position.center.label"},
        {"value": "bottom", "label": "t:sections.image-banner.settings.desktop_text_vertical_position.bottom.label"}
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.desktop_text_vertical_position.label"
    },
    {
      "type": "select",
      "id": "desktop_text_horizontal_position",
      "options": [
        {"value": "left", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.left.label"},
        {"value": "center", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.center.label"},
        {"value": "right", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.right.label"}
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.mobile_version"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "t:sections.logo-banner.settings.video-hosted.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.settings.settings.image.label"
    },
    {
      "type": "select",
      "id": "mobile_text_vertical_position",
      "options": [
        {"value": "top", "label": "t:sections.image-banner.settings.mobile_text_vertical_position.top.label"},
        {"value": "center", "label": "t:sections.image-banner.settings.mobile_text_vertical_position.center.label"},
        {"value": "bottom", "label": "t:sections.image-banner.settings.mobile_text_vertical_position.bottom.label"}
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.mobile_text_vertical_position.label"
    },
    {
      "type": "select",
      "id": "mobile_text_horizontal_position",
      "options": [
        {"value": "left", "label": "t:sections.image-banner.settings.mobile_text_horizontal_position.left.label"},
        {"value": "center", "label": "t:sections.image-banner.settings.mobile_text_horizontal_position.center.label"},
        {"value": "right", "label": "t:sections.image-banner.settings.mobile_text_horizontal_position.right.label"}
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.mobile_text_horizontal_position.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.general"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.quiz.blocks.intro.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.quiz.blocks.intro.settings.heading.label",
      "default": "Find your perfect match"
    },
    {
      "type": "range",
      "id": "size_heading",
      "min": 20,
      "max": 500,
      "step": 10,
      "default": 100,
      "label": "t:sections.settings.settings.size-heading.label",
      "unit": "%"
    },
    {
      "type": "range",
      "id": "size_heading_mobile",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 100,
      "label": "t:sections.settings.settings.size-heading-mobile.label",
      "unit": "%"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.quiz.blocks.intro.settings.body.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.quiz.blocks.intro.settings.cta_label.label",
      "default": "Start quiz"
    },
    {
      "type": "select",
      "id": "button_select",
      "options": [
        {"value": "primary", "label": "t:sections.settings.settings.button_select.primary.label"},
        {"value": "secondary", "label": "t:sections.settings.settings.button_select.secondary.label"},
        {"value": "link", "label": "t:sections.settings.settings.button_select.link.label"}
      ],
      "default": "primary",
      "label": "t:sections.settings.settings.button_select.default.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.global.image-container-color"
    },
    {
      "type": "range",
      "id": "color-overlay-opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.settings.settings.background-opacity.label"
    }
  ]
}
{% endschema %}
