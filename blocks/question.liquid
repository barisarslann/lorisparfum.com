{%- liquid
  assign bg_rgb = block.settings.background_color | color_to_rgb
  assign text_rgb = block.settings.text_color | color_to_rgb
-%}
<style>
  [data-block-id="{{ block.id }}"] {
    {% if block.settings.background_color != blank and block.settings.background_color != 'transparent' and bg_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --quiz-block-bg: {{ block.settings.background_color }};
    {% endif %}
    {% if block.settings.text_color != blank and block.settings.text_color != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --quiz-block-text: {{ block.settings.text_color }};
      --quiz-block-text-rgb: {{ text_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' }};
    {% endif %}
    --quiz-icon-size: {{ block.settings.icon_height | default: 48 }}px;
    --quiz-icon-size-desktop: {{ block.settings.icon_height_desktop | default: 64 }}px;
    --quiz-answers-cols: {{ block.settings.answers_per_row_mobile | default: 1 }};
    --quiz-answers-cols-desktop: {{ block.settings.answers_per_row_desktop | default: 1 }};
  }
</style>

<div class="wt-quiz__question{% if block.settings.icon_alignment == 'left' %} wt-quiz__question--icon-left{% endif %}" data-block-type="question">
  {%- if block.settings.icon != blank or block.settings.select_icon != 'none' -%}
    <div class="wt-quiz__block-icon">
      {%- if block.settings.icon != blank -%}
        <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="{{ block.settings.icon.alt | escape }}" loading="lazy" class="wt-quiz__block-icon__img">
      {%- else -%}
        {%- render 'icons', id: block.settings.select_icon, icon_class: 'wt-quiz__block-icon__svg' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="wt-quiz__question-content">
    {%- if block.settings.heading != blank -%}
      <h3 class="wt-quiz__question-heading hero__title">{{ block.settings.heading }}</h3>
    {%- endif -%}
    {%- if block.settings.body_text != blank -%}
      <div class="wt-quiz__question-body">{{ block.settings.body_text }}</div>
    {%- endif -%}
    <div class="wt-quiz__options wt-quiz__options--icon-list">
      {%- for answer_block in block.blocks -%}
        {% render answer_block %}
      {% endfor %}
    </div>
  </div>
</div>
<div class="wt-quiz__question-nav">
  <button class="wt-quiz__nav-next hero__button hero__button--{{ section.settings.btn_next | default: 'primary' }}" type="button" disabled
    data-next-label="{{ 'sections.quiz.next_question' | t }}"
    data-result-label="{{ 'sections.quiz.see_results' | t }}">
    <span class="wt-quiz__nav-label">{{ 'sections.quiz.next_question' | t }}</span>
  </button>
  <button class="wt-quiz__nav-prev hero__button hero__button--{{ section.settings.btn_prev | default: 'secondary' }}" type="button">
    {{ 'sections.quiz.prev_question' | t }}
  </button>
</div>

