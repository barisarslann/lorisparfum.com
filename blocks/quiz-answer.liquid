{%- if block.settings.icon_advanced_settings -%}
  <style>
    [data-block-id="{{ block.id }}"] {
      --quiz-option-icon-size: {{ block.settings.icon_height }}px;
      --quiz-option-icon-size-desktop: {{ block.settings.icon_height_desktop }}px;
      --quiz-option-icon-margin: {{ block.settings.icon_margin }}px;
      --quiz-option-icon-margin-desktop: {{ block.settings.icon_margin_desktop }}px;
    }
  </style>
{%- endif -%}

<quiz-option class="wt-quiz__option wt-quiz__option--rich-list" data-block-id="{{ block.id }}" data-tags="{{ block.settings.tags }}" {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    <span class="wt-quiz__option-icon"><img src="{{ block.settings.image | image_url: width: 80 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" class="wt-quiz__option-icon-img"></span>
  {%- elsif block.settings.icon != 'none' and block.settings.icon != blank -%}
    <span class="wt-quiz__option-icon">{%- render 'icons', id: block.settings.icon -%}</span>
  {%- endif -%}
  <div class="wt-quiz__option-text-group">
    {%- if block.settings.heading != blank -%}
      <span class="wt-quiz__option-heading">{{ block.settings.heading }}</span>
    {%- endif -%}
    {%- if block.settings.description != blank -%}
      <p class="wt-quiz__option-text">{{ block.settings.description }}</p>
    {%- endif -%}
  </div>
</quiz-option>

