{%- assign bg_rgb = block.settings.background_color | color_to_rgb -%}
{%- assign text_rgb = block.settings.text_color | color_to_rgb -%}
<style>
  [data-block-id="{{ block.id }}"] {
    --quiz-icon-size: {{ block.settings.icon_height | default: 48 }}px;
    --quiz-icon-size-desktop: {{ block.settings.icon_height_desktop | default: 64 }}px;
  }
  [data-block-id="{{ block.id }}"] .wt-quiz__results {
    {% if block.settings.background_color != blank and block.settings.background_color != 'transparent' and bg_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --quiz-results-bg: {{ block.settings.background_color }};
    {% endif %}
    {% if block.settings.text_color != blank and block.settings.text_color != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --quiz-results-text: {{ block.settings.text_color }};
    {% endif %}
  }
</style>

<div class="wt-quiz__results" data-block-type="results" {% if block.settings.redirect_to_result %}data-redirect="true"{% endif %}>
  {%- if block.settings.icon != blank or block.settings.select_icon != 'none' -%}
    <div class="wt-quiz__block-icon">
      {%- if block.settings.icon != blank -%}
        <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="{{ block.settings.icon.alt | escape }}" loading="lazy" class="wt-quiz__block-icon__img">
      {%- else -%}
        {%- render 'icons', id: block.settings.select_icon, icon_class: 'wt-quiz__block-icon__svg' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <h3 class="wt-quiz__results-heading hero__title">{{ block.settings.heading }}</h3>
  {%- endif -%}

  <div class="wt-quiz__results--wrapper">
    <div class="wt-quiz__result-info" hidden></div>

    <div class="wt-quiz__result-items">
      {%- for result_block in block.blocks -%}
        {%- render result_block -%}
      {%- endfor -%}
    </div>

    <div class="wt-quiz__result-fallback" hidden>
      {%- if block.settings.no_result_heading != blank -%}
        <h4 class="hero__title">{{ block.settings.no_result_heading }}</h4>
      {%- endif -%}
      {%- if block.settings.no_result_body != blank -%}
        <div>{{ block.settings.no_result_body }}</div>
      {%- endif -%}
    </div>
  </div>

  <div class="wt-quiz__result-actions">
    <button class="wt-quiz__retake hero__button hero__button--{{ block.settings.button_select | default: 'primary' }}" type="button">
      <span>{{ block.settings.retake_label | default: 'Retake quiz' }}</span>
    </button>
  </div>
</div>

