    {%- render 'ecom_footer' -%}
    
    <!-- Gül ve Kalp Emoji

<canvas id="emoji-flower-canvas" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999;"></canvas>
 


<canvas id="rose-heart-canvas" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999;"></canvas>

<script>
  (function() {
    const canvas = document.getElementById('rose-heart-canvas');
    const ctx = canvas.getContext('2d');
    
    let width, height;
    let particles = [];
    
    // --- SADELEŞTİRİLMİŞ AYARLAR ---
    const particleCount = 10;     // Sayı azaltıldı (Daha sade bir görünüm için)
    const connectionRadius = 130; // Kaçış mesafesi
    const pushForce = 5;          // İtme gücü
    const baseSize = 10;          // Boyut küçültüldü (Minimum 10px)

    // --- SADECE GÜL VE KALP ---
    const emojis = [
      "🌹", 
      "❤️"  
    ];
    // ------------------------------------------------

    let mouse = { x: -1000, y: -1000 };

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    window.addEventListener('touchmove', (e) => {
      if(e.touches.length > 0) {
        mouse.x = e.touches[0].clientX;
        mouse.y = e.touches[0].clientY;
      }
    });
    
    window.addEventListener('mouseout', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    window.addEventListener('resize', resize);
    resize();

    class Particle {
      constructor() {
        this.init();
      }

      init() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 1; 
        this.vy = Math.random() * 2.5 + 1; // Yavaşça süzülme
        
        // Boyutlar 15px ile 25px arasında rastgele olacak (Çok daha küçük)
        this.size = Math.random() * 10 + baseSize; 
        
        // Dönme (Rotasyon) ayarları
        this.angle = Math.random() * Math.PI * 2; 
        this.rotationSpeed = (Math.random() - 0.5) * 0.03; 

        // Listeden gül veya kalp seç
        this.emoji = emojis[Math.floor(Math.random() * emojis.length)];

        this.originalVx = this.vx;
        this.originalVy = this.vy;
      }

      update() {
        const dx = this.x - mouse.x;
        const dy = this.y - mouse.y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < connectionRadius) {
          const forceDirectionX = dx / distance;
          const forceDirectionY = dy / distance;
          const force = (connectionRadius - distance) / connectionRadius;
          
          this.vx += forceDirectionX * force * pushForce;
          this.vy += forceDirectionY * force * pushForce;
        }

        this.x += this.vx;
        this.y += this.vy;
        this.angle += this.rotationSpeed; 

        this.vx = this.vx * 0.9 + this.originalVx * 0.1;
        this.vy = this.vy * 0.9 + this.originalVy * 0.1;

        if (this.y > height + 30) { 
          this.y = -30; 
          this.x = Math.random() * width;
          this.emoji = emojis[Math.floor(Math.random() * emojis.length)];
        }
        if (this.x > width + 30) this.x = -30;
        if (this.x < -30) this.x = width + 30;
      }

      draw() {
        ctx.save(); 
        ctx.translate(this.x, this.y); 
        ctx.rotate(this.angle); 
        
        ctx.font = `${this.size}px Arial, sans-serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        
        ctx.fillText(this.emoji, 0, 0);
        
        ctx.restore(); 
      }
    }

    function initParticles() {
        for (let i = 0; i < particleCount; i++) {
          particles.push(new Particle());
        }
    }

    function animate() {
      ctx.clearRect(0, 0, width, height);
      particles.forEach(p => {
        p.update();
        p.draw();
      });
      requestAnimationFrame(animate);
    }

    initParticles();
    animate();

  })();
</script>
 -->
<style>
  .wt-product__sticky-buy {display: none;}
  .wt-sticky-price-display br:first-of-type {display: none;}

  /* 1. GENEL AYAR: Masaüstünde Sticky Bar'ı GİZLE */
  .mobile-sticky-bar-wrapper { 
    display: none !important; 
  }

  /* 2. MOBİL AYARLARI */
  @media screen and (max-width: 900px) {
    
    /* STICKY BAR AÇIK (BÜYÜK) HALİ */
    body.template-product .mobile-sticky-bar-wrapper {
      display: block !important;
      position: fixed !important;
      bottom: 95px !important; 
      left: 50% !important; 
      transform: translateX(-50%) !important; 
      width: 92% !important;
      max-width: 400px !important;
      background-color: #ffffff !important;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
      z-index: 10 !important; 
      border-radius: 15px !important;
      overflow: hidden !important;
      border: 1px solid #f0f0f0 !important;
      transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important; 
    }

    /* ÇARPIYA BASILDIĞINDA ÇALIŞACAK KOD (KÜÇÜK HALİ) */
    body.template-product .mobile-sticky-bar-wrapper.sticky-minimized {
      bottom: 15px !important; 
      width: 325px !important; /* DÜZELTME: İçerik biraz daha daraltıldı */
      transform: translateX(-50%) scale(0.57) !important; /* DÜZELTME: İkonlara hiç değmemesi için biraz daha fazla küçültüldü */
      transform-origin: center bottom !important; 
      z-index: 9999 !important; 
      box-shadow: 0 5px 20px rgba(0,0,0,0.15) !important;
    }

    /* Orijinal Sepete Ekle Butonunu Gizle */
    body.template-product main button[name="add"],
    body.template-product main #ProductSubmitButton-template--product,
    body.template-product main .product-form__submit {
      position: absolute !important;
      visibility: hidden !important;
      opacity: 0 !important;
      height: 0 !important;
      width: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: hidden !important;
      border: none !important;
      z-index: -1 !important;
    }

    /* Orijinal Hemen Satın Al Butonunu GÖSTER */
    body.template-product main .shopify-payment-button {
      display: block !important;
      visibility: visible !important;
      margin: 10px 0 !important;
    }

    /* Sayfanın en altındaki boşluk */
    body.template-product { 
      padding-bottom: 240px !important; 
    }
  }

  /* STICKY BAR İÇ TASARIMI */
  .campaign-badge {
    background-color: #fff5eb !important;
    color: #ec5353 !important;
    font-weight: 700 !important;
    font-size: 11px !important;
    padding: 8px 10px !important;
    text-align: center !important;
    border-bottom: 1px solid #ffe5d1 !important;
  }

  .sticky-shipping-info {
    background-color: #fdf7f2 !important;
    font-size: 10px !important;
    padding: 5px !important;
    text-align: center;
    color: #333 !important;
  }

  .sticky-bar-content {
    display: flex !important;
    align-items: center !important;
    padding: 10px 15px !important;
    gap: 12px !important;
  }

  .sticky-price { 
    font-size: 18px !important; 
    color: #000 !important; 
    font-weight: 800 !important;
    white-space: nowrap !important;
  }

  .sticky-add-button {
    background-color:rgb(6, 6, 6) !important;
    color: #fff !important;
    border: none !important;
    padding: 12px !important;
    border-radius: 10px !important;
    font-weight: 700 !important;
    font-size: 14px !important;
    flex-grow: 1 !important;
    text-transform: uppercase !important;
  }
</style>
</body>
