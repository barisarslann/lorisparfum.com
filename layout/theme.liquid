        </nav>
        <div class="wt__quick-buy--wrapper">
          <div class="wt__quick-buy-loader">
            {% render 'loader' %}
          </div>
          <div class="wt__quick-buy__view-all-container hidden">
            <a href="#">
              {{ 'general.quick_add.view_all_details' | t }}
