<script src="{{ 'img-comparison-slider-v8.js' | asset_url }}" defer="defer"></script>
{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}
{{ 'img-comparison-slider-v8.css' | asset_url | stylesheet_tag }}

{% assign background_section_rgb = section.settings['section-color-overlay'] | color_to_rgb %}
{% assign heading_rgb = section.settings['section-color-body-text'] | color_to_rgb %}

{% assign background_rgb = section.settings['color-overlay'] | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

<style>
    section[id="shopify-section-{{ section.id }}"]{
        {% if section.settings['section-color-overlay'] != blank and section.settings['section-color-overlay'] != 'transparent' and background_section_rgb != 'rgba(0, 0, 0, 0.0)' %}
            --color-overlay-rgb: {{ section.settings.section-color-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
            --color-overlay-opacity: {{ section.settings.section-color-overlay-opacity | divided_by: 100.0 }};
        {% endif %}
    }

    section[id="shopify-section-{{ section.id }}"] .headline__title,
    section[id="shopify-section-{{ section.id }}"] div.headline--rich{
      {% if section.settings['section-color-body-text'] != blank and section.settings['section-color-body-text'] != 'transparent' and heading_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.section-color-body-text }};
      {% endif %}
    }

  {% if section.settings['color-overlay'] == blank or section.settings['color-overlay'] == 'transparent' or background_rgb == 'rgba(0, 0, 0, 0.0)' %}
    section[id="shopify-section-{{ section.id }}"] .wt-before-after__container {
      border-radius: var(--border-radius);
      overflow: hidden;
    }
  {% endif %}

  [data-section-id="{{ section.id }}"]
  {
      {% if section.settings['color-overlay'] != blank and section.settings['color-overlay'] != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-overlay-rgb: {{ section.settings.color-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
        --color-overlay-opacity: {{ section.settings.color-overlay-opacity | divided_by: 100.0 }};
      {% endif %}

      {% if section.settings.full-width-enabled %}
        --border-radius: 0;
      {% endif %}

      {% if section.settings.margin-top %}
        --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}

      {% if section.settings.margin-bottom %}
        --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}


      {% if section.settings.show_mobile_spacing %}
          --section-gap-top-mobile: {{ section.settings.margin-top-mobile }}px;
      {% endif %}

      {% if section.settings.show_mobile_spacing %}
          --section-gap-bottom-mobile: {{ section.settings.margin-bottom-mobile }}px;
      {% endif %}

      --desktop-percentage-image-width: {% if section.blocks.size > 0 %}{{ section.settings.desktop-percentage-image-width }}%{% else %}100%{% endif %};

    {% if section.settings.slide_height == 'fixed_height' %}
    --section-height: {{ section.settings.mobile_fixed_height }}px;
    --section-height-desk: {{ section.settings.desktop_fixed_height }}px;
    {% endif %}

    {% if section.settings.slide_height == 'adapt_to_first_image' %}
        {% assign ratio_img = section.settings.before_image | default: section.settings.after_image %}
        --first-slide-ratio: {{ ratio_img.aspect_ratio | default: 1 }};
        --first-slide-ratio-desk: {{ ratio_img.aspect_ratio | default: 2.5 }};
    {% endif %}

  }

  [data-section-id="{{ section.id }}"] .hero
    {
        {% if section.settings['color-body-text'] != blank and section.settings['color-body-text'] != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
          --color-custom-text: {{ section.settings.color-body-text }};
        {% endif %}
    }

  {%- for block in section.blocks -%}
  [data-block-id="{{ block.id }}"]
  {

        --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};

        --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};

        {% if block.type == 'text' and block.settings.text_style == 'subtitle' %}
            --font-base: var(--font-headline);
        {% endif %}

        {% if block.type == 'subheading' and block.settings.subheading_advanced_settings %}
          --font-subheading-scale: {{ block.settings.size_text_mobile | divided_by: 100.0 }};
          --font-subheading-scale-desk: {{ block.settings.size_text_desktop | divided_by: 100.0 }};
          --subheading-letter-spacing: {{ block.settings.letter_spacing }}px;
          {% if block.settings.text_uppercase %}
            --subheading-text-transform: uppercase;
          {% endif %}
          {% if block.settings.text_style == 'body' %}
            --subheading-font-family: var(--font-base);
          {% endif %}
        {% endif %}
  }
  {%- endfor -%}
</style>

{% if section.blocks.size > 0 %}
  {% if section.settings.layout == 'text_first' %}
    {% assign customclass = 'hero--grid hero--grid--rev' %}
  {% else %}
    {% assign customclass = 'hero--grid' %}
  {% endif %}
{% else %}
  {% assign customclass = '' %}
{% endif %}

{% if section.settings['full-width-enabled'] %}
  {% assign customwrapperclass = 'hero__wrapper--full' %}
{% else %}
  {% assign customwrapperclass = 'hero__wrapper' %}
{% endif %}

<div
  data-section-id="{{ section.id }}"
  data-height="{{ section.settings.slide_height }}"
  class="wt-before-after {{ customwrapperclass }}  {% if settings.animations and section.settings['full-width-enabled'] != true %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}"
>
  {% if section.settings.advanced_heading %}
    {% if section.settings.heading_richtext != blank %}
        <div class="headline headline--rich {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
            {{ section.settings.heading_richtext }}
        </div>
    {% endif %}
  {% else %}
    {% if section.settings.title != blank %}
        {% render 'headline', title: section.settings.title %}
    {% endif %}
  {% endif %}

  <div class="{% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
    {% render 'hero',
      type: 'blocks',
      classname: customclass,
      desktop_text_horizontal_position: section.settings.desktop_text_horizontal_position,
      desktop_text_vertical_position: section.settings.desktop_text_vertical_position,
      mobile_text_horizontal_position: section.settings.mobile_text_horizontal_position,
      mobile_text_vertical_position: section.settings.mobile_text_vertical_position,
      desktop_image: section.settings.desktop_image,
      mobile_image: section.settings.mobile_image,
      placeholder: 'detailed-apparel-1',
      blocks: section.blocks,
      before_after: true
    %}
  </div>
</div>

{% schema %}
