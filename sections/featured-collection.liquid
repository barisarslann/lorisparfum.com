{% liquid
  assign products_source = section.settings.collection.products
  assign show_section = false

  if section.settings.product_list != empty
    assign products_source = section.settings.product_list
  endif

  if request.design_mode == true or section.settings.hide_empty_section == false or section.settings.hide_empty_section == true and products_source != blank
    assign show_section = true
  endif
%}

{% if show_section %}
  {{ 'swiper.css' | asset_url | stylesheet_tag }}

  {% assign background_rgb = section.settings.background_color | color_to_rgb %}
  {% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

  <style>
      [data-section-id="{{ section.id }}"]
      {

      {% if section.settings.background_color != blank and section.settings.background_color != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-background: {{ section.settings.background_color }};
      {% endif %}

      {% if section.settings.margin-top %}
        --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}

      {% if section.settings.margin-bottom %}
        --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}

      {%- if section.settings.show_mobile_spacing -%}
          --section-gap-top-mobile: {{ section.settings.margin-top-mobile }}px;
      {%- endif -%}

      {%- if section.settings.show_mobile_spacing -%}
          --section-gap-bottom-mobile: {{ section.settings.margin-bottom-mobile }}px;
      {%- endif -%}

    }

    [data-section-id="{{ section.id }}"]
    {
      {% if section.settings['color-body-text'] != blank and section.settings['color-body-text'] != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.color-body-text }};
        --color-price: {{ section.settings.color-body-text }};
        --color-brand: {{ section.settings.color-body-text }};
        --color-star-rating: {{ section.settings.color-body-text }};
        --color-sale-price: {{ section.settings.color-body-text }};
      {% endif %}
      {% if section.settings.enable_stack_products %}
        --grid-col-mobile:{{ section.settings.number_of_column_mobile | floor }};
        --grid-col:{{ section.settings.number_of_column_desktop | floor }};
        --grid-gap: {{ section.settings.spacing_desktop }}px;
      {% endif %}
      --grid-gap-mobile: {{ section.settings.spacing_mobile }}px;
    }
  </style>
  {% if section.settings.enable_quick_add_button %}
    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'subscription-widget.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'variant-dropdown.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {% if section.settings.card_style == 'pro' %}
    {% render 'card-pro-scripts', section: section %}
  {% endif %}

  <div
    data-section-id="{{ section.id }}"
    class="wt-featured-collection wt-slider {% if section.settings.disable_on_mobile %}wt-featured-collection--disable-on-mobile{% endif %}"
  >
  {% if section.settings.advanced_heading %}
    {% if section.settings.heading_richtext != blank %}
        <div class="headline headline--rich {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} {% if section.settings.disable_on_mobile %}disable-on-mobile{% endif %}">
            {{ section.settings.heading_richtext }}
        </div>
    {% endif %}
  {% else %}
    {% if section.settings.title != blank %}
        <div class="headline {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} {% if section.settings.disable_on_mobile %}disable-on-mobile{% endif %}">
        {% render 'simple-block', prefix: 'headline', title: section.settings.title %}
      </div>
    {% endif %}
  {% endif %}

    <script type="module" src="{{ 'slider.js' | asset_url }}" defer="defer"></script>

    <!-- Slider main container -->
    <slideshow-section
      class="wt-slider {% if section.settings.make_products_full_width %} wt-slider--full {% endif %}"
      data-slides-group
    >
      <div
        data-swiper
        class="wt-slider__container--featured loading  {% if section.settings.make_products_full_width %} wt-slider__container--full {% endif %}"
      >
        <!-- Additional required wrapper -->
        <div
          data-swiper-container
          {% if section.settings.enable_stack_products %}
            class=" wt-slider__wrapper--stack {% if section.settings.number_of_column_desktop == 2%} wt-slider__wrapper--stack-2-col {% endif %}"
          {% endif %}
        >
          <!-- Slides -->
          {%- if products_source == blank -%}
            {% for i in (1..section.settings.products_to_show) %}
                <div data-swiper-slide>
                    <div
                        {% if settings.animations %}
                          data-cascade
                          class="scroll-trigger animate--slide-in {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}"
                          style="--animation-order: {{ i }};"
                        {% else %}
                          class="wt-slider__card-wrapper"
                        {% endif %}
                      >
                        {% assign placeholder_image_index = i | modulo: 4 %}
                        {% if placeholder_image_index == 0 %}
                          {% assign placeholder_image_index = 1 %}
                        {% endif %}
                        {% render 'card-render',
                          card_style: section.settings.card_style,
                          placeholder_image_index: placeholder_image_index,
                          title: 'Example product title',
                          subtitle: 'Vendor',
                          price: '1999',
                          rating: section.settings.show_product_rating,
                          show_review_count: section.settings.show_review_count,
                          options: false,
                          text_alignment: section.settings.text_alignment,
                          enable_quick_add_button: section.settings.enable_quick_add_button,
                          quick_add_mode: section.settings.quick_add_mode
                        %}
                      </div>
                </div>
            {% endfor %}
          {%- endif -%}
          {%- for product in products_source limit: section.settings.products_to_show -%}
            <div data-swiper-slide>
              {% if section.settings.show_secondary_image and product.images[1] %}
                {% assign image_hover = product.images[1] %}
              {% else %}
                {% assign image_hover = false %}
              {% endif %}
              <div
                {% if settings.animations %}
                  data-cascade
                  class="scroll-trigger animate--slide-in {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}"
                  style="--animation-order: {{ forloop.index }};"
                {% else %}
                  class="wt-slider__card-wrapper"
                {% endif %}
              >
                {% render 'card-render',
                  card_style: section.settings.card_style,
                  card_product: product,
                  img: product.featured_media,
                  img_hover: image_hover,
                  title: product.title,
                  subtitle: product.vendor,
                  rating: section.settings.show_product_rating,
                  show_review_count: section.settings.show_review_count,
                  hide_rating_no_reviews: section.settings.hide_rating_no_reviews,
                  reviews: product.metafields.reviews,
                  options: false,
                  url: product.url,
                  uri: product.handle,
                  text_alignment: section.settings.text_alignment,
                  variants: product.variants,
                  product_options: product.options,
                  product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  enable_quick_add_button: section.settings.enable_quick_add_button,
                  quick_add_mode: section.settings.quick_add_mode,
                  enable_vendor_link: section.settings.enable_vendor_link,
                  show_video: section.settings.show_video
                %}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {% unless section.settings.enable_stack_products %}
          <!-- Add Arrows -->
          <div class="swiper-button-next wt-slider__nav-btn wt-slider__nav-next wt-slider__nav-next--featured">
            {% render 'icons', id: 'arrow-right' %}
          </div>
          <div class="swiper-button-prev wt-slider__nav-btn wt-slider__nav-prev wt-slider__nav-prev--featured">
            {% render 'icons', id: 'arrow-left' %}
          </div>

          <!-- If we need scrollbar -->
          <div
            class="swiper-scrollbar wt-slider__scrollbar wt-slider__scrollbar--featured {% if section.settings.make_products_full_width %} wt-slider__scrollbar--full {% endif %}"
          ></div>
        {% endunless %}

        <script data-swiper-configuration type="text/json">
          {
            "enabled": {% unless section.settings.enable_stack_products %}true{% else %}false{% endunless %},
            "slidesPerView": "auto",
            "freeMode": false,
            "centeredSlides": false,
            "slideToClickedSlide": false,
            "centeredSlidesBounds": true,
            "watchSlidesProgress": true,
            "enableAnimation": {{ settings.animations }},
            "disableAnimationOnMobile": {{ settings.disabled_animations_on_mobile }},
            "speed": 150,
            "grabCursor": false,
            "paginationType": "bullets",
          {% if section.settings.enable_stack_products %}
            "navigation": false,
            "scrollbar": false,
          {% else %}
            "breakpoints": {
              "320": {
                "slidesPerView": {{ section.settings.number_of_column_mobile }},
                "slidesPerGroup": {{ section.settings.number_of_column_mobile | floor }},
                "spaceBetween": {{ section.settings.spacing_mobile | floor }}
              },
              "900": {
                "slidesPerView": {{ section.settings.number_of_column_desktop }},
                "slidesPerGroup": {{ section.settings.number_of_column_desktop | floor }},
                "spaceBetween": {{ section.settings.spacing_desktop | floor }}
              }
            },
            "navigation": {
              "nextEl": ".wt-slider__nav-next--featured",
              "prevEl": ".wt-slider__nav-prev--featured"
            },
            "scrollbar": {
              "el": ".wt-slider__scrollbar--featured",
              "draggable": true
            },
          {% endif %}
          "pagination": false
        }
        </script>
      </div>
    </slideshow-section>

    {% if section.settings.show_view_all
      and section.settings.collection.products_count > section.settings.products_to_show
      and section.settings.product_list == empty
    %}
      <div class="wt-featured-collection__button-container wt-button__container">
        <button
          aria-label="{{ 'aria-label.featured-collection' | t }}"
          class="hero__button--primary {% if section.settings.button_select != 'primary' %} hero__button--secondary {% endif %}{% if section.settings.button_select == 'link' %} hero__button--link {% endif %}"
          onclick='location.href="{{ routes.collections_url }}/{{ section.settings.collection.handle }}"'
        >
          <span class="wt-newsletter__send__text">{{ 'aria-label.featured-collection' | t }}</span>
        </button>
      </div>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.featured-collection.settings.support_info.content"
    },
    {
      "type": "checkbox",
      "id": "advanced_heading",
      "label": "t:sections.global.advanced_heading.label",
      "info": "t:sections.global.advanced_heading.info"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "t:sections.settings.settings.heading.label",
      "default": "Featured collection",
      "visible_if": "{{ section.settings.advanced_heading == false }}"
    },
    {
      "type": "richtext",
      "id": "heading_richtext",
      "label": "t:sections.logo-banner.settings.content.headline.label",
      "default": "<h2>Featured collection</h2>",
      "visible_if": "{{ section.settings.advanced_heading == true }}"
    },
    {
      "type": "checkbox",
      "id": "disable_on_mobile",
      "label": "t:sections.global.heading_disable_on_mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_empty_section",
      "label": "t:sections.featured-collection.settings.hide_empty_section.label",
      "info": "t:sections.featured-collection.settings.hide_empty_section.info",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:sections.featured-collection.settings.products.label",
      "info": "t:sections.featured-collection.settings.products.info"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "checkbox",
      "id": "enable_stack_products",
      "default": false,
      "label": "t:sections.featured-collection.settings.enable_stack_products.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "info": "t:sections.featured-collection.settings.show_view_all.info"
    },
    {
      "type": "select",
      "id": "button_select",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.settings.settings.button_select.primary.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.settings.settings.button_select.secondary.label"
        },
        {
          "value": "link",
          "label": "t:sections.settings.settings.button_select.link.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.featured-collection.settings.button_select.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.desktop_version"
    },
    {
      "type": "range",
      "id": "number_of_column_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.number_of_column_desktop.label"
    },
    {
      "type": "select",
      "id": "spacing_desktop",
      "options": [
        {
          "value": "8",
          "label": "t:sections.main-collection-product-grid.settings.spacing_desktop.1.label"
        },
        {
          "value": "16",
          "label": "t:sections.main-collection-product-grid.settings.spacing_desktop.2.label"
        },
        {
          "value": "24",
          "label": "t:sections.main-collection-product-grid.settings.spacing_desktop.3.label"
        }
      ],
      "default": "16",
      "label": "t:sections.main-collection-product-grid.settings.spacing_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "make_products_full_width",
      "default": true,
      "label": "t:sections.featured-collection.settings.make_products_full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.mobile_version"
    },
    {
      "type": "range",
      "id": "number_of_column_mobile",
      "min": 1.1,
      "max": 2.5,
      "step": 0.1,
      "default": 2.1,
      "label": "t:sections.featured-collection.settings.number_of_column_mobile.label"
    },
    {
      "type": "select",
      "id": "spacing_mobile",
      "options": [
        {
          "value": "4",
          "label": "t:sections.featured-collection.settings.spacing_mobile.options__1.label"
        },
        {
          "value": "8",
          "label": "t:sections.featured-collection.settings.spacing_mobile.options__2.label"
        },
        {
          "value": "12",
          "label": "t:sections.featured-collection.settings.spacing_mobile.options__3.label"
        },
        {
          "value": "16",
          "label": "t:sections.featured-collection.settings.spacing_mobile.options__4.label"
        }
      ],
      "default": "16",
      "label": "t:sections.featured-collection.settings.spacing_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "card_style",
      "options": [
        {
          "value": "classic",
          "label": "t:sections.global.card_style.options.classic.label"
        },
        {
          "value": "pro",
          "label": "t:sections.global.card_style.options.pro.label"
        }
      ],
      "default": "classic",
      "label": "t:sections.global.card_style.label",
      "info": "t:sections.global.card_style.info"
    },
    {
      "type": "range",
      "id": "card_gallery_max_images",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "label": "t:sections.global.card_gallery_max_images.label",
      "info": "t:sections.global.card_gallery_max_images.info",
      "visible_if": "{{ section.settings.card_style == 'pro' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_buy_picker",
      "default": false,
      "label": "t:sections.global.quick_buy_picker.enable.label",
      "info": "t:sections.global.quick_buy_picker.enable.info",
      "visible_if": "{{ section.settings.card_style == 'pro' }}"
    },
    {
      "type": "textarea",
      "id": "quick_buy_picker_option_names",
      "placeholder": "t:sections.featured-collection.settings.quick_buy_picker_option_names.placeholder",
      "default": "Size",
      "label": "t:sections.global.quick_buy_picker.option_names.label",
      "info": "t:sections.global.quick_buy_picker.option_names.info",
      "visible_if": "{{ section.settings.enable_quick_buy_picker }}"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "center",
          "label": "t:sections.featured-collection.settings.text_alignment.center.label"
        },
        {
          "value": "left",
          "label": "t:sections.featured-collection.settings.text_alignment.left.label"
        }
      ],
      "default": "left",
      "label": "t:sections.featured-collection.settings.text_alignment.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.featured-collection.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_video.label",
      "info": "t:sections.main-collection-product-grid.settings.show_video.info",
      "visible_if": "{{ section.settings.card_style != 'pro' }}"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_secondary_image.label",
      "visible_if": "{{ section.settings.card_style != 'pro' }}"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "enable_vendor_link",
      "label": "t:sections.global.enable_vendor_link",
      "visible_if": "{{ section.settings.show_vendor }}"
    },
    {
      "type": "checkbox",
      "id": "show_product_rating",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_product_rating.label",
      "info": "t:sections.featured-collection.settings.show_product_rating.info"
    },
    {
      "type": "checkbox",
      "id": "show_review_count",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_review_count.label",
      "info": "t:sections.featured-collection.settings.show_review_count.info",
      "visible_if": "{{ section.settings.show_product_rating }}"
    },
    {
      "type": "checkbox",
      "id": "hide_rating_no_reviews",
      "default": false,
      "label": "t:sections.featured-collection.settings.hide_rating_no_reviews.label",
      "visible_if": "{{ section.settings.show_product_rating }}"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add_button",
      "default": false,
      "label": "t:sections.featured-collection.settings.enable_quick_add_button.label",
      "info": "t:sections.featured-collection.settings.enable_quick_add_button.info",
      "visible_if": "{{ section.settings.card_style != 'pro' }}"
    },
    {
      "type": "select",
      "id": "quick_add_mode",
      "label": "t:sections.featured-collection.settings.quick_add_layout.label",
      "options": [
        {
          "value": "hover_desktop",
          "label": "t:sections.featured-collection.settings.quick_add_layout.options.hover.label"
        },
        {
          "value": "below_product",
          "label": "t:sections.featured-collection.settings.quick_add_layout.options.below.label"
        }
      ],
      "default": "hover_desktop",
      "visible_if": "{{ section.settings.card_style != 'pro' and section.settings.enable_quick_add_button }}"
    },
    {
      "type": "header",
      "content": "t:sections.global.quick_buy_picker.size_guide.header",
      "visible_if": "{{ section.settings.card_style == 'pro' and section.settings.enable_quick_buy_picker }}"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-product.blocks.information_popup.settings.documentation.content",
      "visible_if": "{{ section.settings.card_style == 'pro' and section.settings.enable_quick_buy_picker }}"
    },
    {
      "type": "text",
      "id": "quick_buy_picker_size_guide_link",
      "label": "t:sections.global.quick_buy_picker.size_guide.link.label",
      "info": "t:sections.global.quick_buy_picker.size_guide.link.info",
      "visible_if": "{{ section.settings.card_style == 'pro' and section.settings.enable_quick_buy_picker }}"
    },
    {
      "type": "page",
      "id": "quick_buy_picker_size_guide_content",
      "label": "t:sections.global.quick_buy_picker.size_guide.content.label",
      "info": "t:sections.global.quick_buy_picker.size_guide.content.info"
    },
    {
      "type": "text",
      "id": "quick_buy_picker_size_guide_metafield",
      "label": "t:sections.global.quick_buy_picker.size_guide.metafield.label",
      "info": "t:sections.global.quick_buy_picker.size_guide.metafield.info",
      "visible_if": "{{ section.settings.card_style == 'pro' and section.settings.enable_quick_buy_picker }}"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.settings.settings.background-color.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 20,
      "label": "t:sections.rich-text.settings.top_distance.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 20,
      "label": "t:sections.rich-text.settings.bottom_distance.label",
      "info": "t:sections.separator.settings.separator-bottom.info"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_spacing",
      "label": "t:sections.settings.settings.show-mobile-spacing.label"
    },
    {
      "type": "range",
      "id": "margin-top-mobile",
      "min": 0,
      "max": 100,
