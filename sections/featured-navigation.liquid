{{ 'swiper.css' | asset_url | stylesheet_tag }}

{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}
{% assign active_background_rgb = section.settings.active_background_color | color_to_rgb %}
{% assign active_text_rgb = section.settings.active_text_color | color_to_rgb %}
{% assign hover_active_text_rgb = section.settings.hover_active_text_color | color_to_rgb %}

<style>
  [id="shopify-section-{{ section.id }}"]
  {
    {% if section.settings.background_color != blank and section.settings.background_color != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-background: {{ section.settings.background_color }};
    {% endif %}

    {% if section.settings['color-body-text'] != blank and section.settings['color-body-text'] != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-custom-text: {{ section.settings.color-body-text }};
    {% endif %}

    {% if section.settings.active_background_color != blank and section.settings.active_background_color != 'transparent' and active_background_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-active-background: {{ section.settings.active_background_color }};
    {% endif %}

    {% if section.settings.active_text_color != blank and section.settings.active_text_color != 'transparent' and active_text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-active-text: {{ section.settings.active_text_color }};
    {% endif %}

    {% if section.settings.hover_active_text_color != blank and section.settings.hover_active_text_color != 'transparent' and hover_active_text_rgb != 'rgba(0, 0, 0, 0.0)' %}
      --color-hover-active-text: {{ section.settings.hover_active_text_color }};
    {% endif %}

    {% if section.settings.button_text_style == 'button' %}
      --featured-nav-link-font: var(--font-button);
      --featured-nav-link-font-style: var(--font-button-style);
      --featured-nav-link-font-weight: var(--font-button-weight);
      --featured-nav-link-transform: var(--font-button-transform, none);
      --featured-nav-link-letter-spacing: var(--font-button-letter-spacing, normal);
    {% endif %}
  }

  [data-section-id="{{ section.id }}"]
  {
      {% if section.settings.margin-top %}
          --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}

      {% if section.settings.margin-bottom %}
          --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}

      {%- if section.settings.show_mobile_spacing -%}
          --section-gap-top-mobile: {{ section.settings.margin-top-mobile }}px;
      {%- endif -%}

      {%- if section.settings.show_mobile_spacing -%}
          --section-gap-bottom-mobile: {{ section.settings.margin-bottom-mobile }}px;
      {%- endif -%}

  }
</style>

{% liquid
  assign button_select = section.settings.button_select
  assign menu_links = linklists[section.settings.menu].links
  assign break_flag = false

  for link in linklists[section.settings.menu].links
    if link.active
      break
    endif

    if link.child_active
      for sublink in link.links
        if sublink.active
          assign menu_links = link.links
          assign break_flag = true
          break
        endif
        if sublink.child_active
          assign menu_links = sublink.links
          assign break_flag = true
          break
        endif
      endfor
    endif

    if break_flag
      break
    endif
  endfor
%}

<script src="{{ 'secondary-nav.js' | asset_url }}" type="module" defer="defer"></script>

<div class="{% if settings.animations %} scroll-trigger animate--slide-in {% endif %}" data-section-id="{{ section.id }}">
  {% if section.settings.advanced_heading %}
    {% if section.settings.heading_richtext != blank %}
        <div class="headline headline--rich {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
            {{ section.settings.heading_richtext }}
        </div>
    {% endif %}
  {% else %}
    {% if section.settings.heading != blank %}
        {% render 'headline', title: section.settings.heading %}
    {% endif %}
  {% endif %}

  <secondary-nav
    {% if section.settings.desktop_placement == 'center' %}
      data-center-slides
    {% endif %}
  >
    <div class="secondary-navigation">
      <div class="secondary-navigation__swiper swiper">
        <div class="secondary-navigation__swiper-wrapper swiper-wrapper
            {% if section.settings.desktop_placement == 'center' %}
              secondary-navigation__swiper-wrapper--center
            {% endif %}
          ">
          {% for link in menu_links %}
            <!-- menu content -->
            <div class="secondary-navigation__swiper-slide {% if link.active %}secondary-navigation__swiper-slide--active{% endif %} swiper-slide">
              <a
                href="{{ link.url }}"
                aria-label="{{ link.title }}"
                class="secondary-navigation__link hero__button hero__button--primary {% if link.active %}secondary-navigation__link--active{% endif %}{% if button_select != 'primary' %} hero__button--secondary{% endif %}{% if button_select == 'link' %} hero__button--link{% endif %}"
              >
                {{ link.title }}
              </a>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-button-prev wt-slider__nav-btn wt-slider__nav-prev">
          {% render 'icons', id: 'arrow-left' %}
        </div>
        <div class="swiper-button-next wt-slider__nav-btn wt-slider__nav-next">
          {% render 'icons', id: 'arrow-right' %}
        </div>
      </div>
    </div>
  </secondary-nav>
</div>

{% schema %}
{
  "name": "t:sections.featured-navigation.name",
  "tag": "section",
  "class": "spaced-section wt-featured-nav",
  "settings": [
    {
      "type": "checkbox",
      "id": "advanced_heading",
      "label": "t:sections.global.advanced_heading.label",
      "info": "t:sections.global.advanced_heading.info"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.settings.settings.heading.label",
      "default": "Featured Navigation",
      "visible_if": "{{ section.settings.advanced_heading == false }}"
    },
    {
      "type": "richtext",
      "id": "heading_richtext",
      "label": "t:sections.logo-banner.settings.content.headline.label",
      "default": "<h2>Featured Navigation</h2>",
      "visible_if": "{{ section.settings.advanced_heading == true }}"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "select",
      "id": "desktop_placement",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.featured_navigation.settings.desktop_placement.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-banner.button.name"
    },
    {
      "type": "select",
      "id": "button_select",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.settings.settings.button_select.primary.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.settings.settings.button_select.secondary.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.settings.settings.button_select.default.label"
    },
    {
      "type": "select",
      "id": "button_text_style",
      "options": [
        {
          "value": "body",
          "label": "t:sections.featured-navigation.settings.button_text_style.options.body.label"
        },
        {
          "value": "button",
          "label": "t:sections.featured-navigation.settings.button_text_style.options.button.label"
        }
      ],
      "default": "body",
      "label": "t:sections.featured-navigation.settings.button_text_style.label"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "t:sections.featured-navigation.settings.active_text_color.label"
    },
    {
      "type": "color",
      "id": "hover_active_text_color",
      "label": "t:sections.featured-navigation.settings.hover_active_text_color.label"
    },
    {
      "type": "color",
      "id": "active_background_color",
      "label": "t:sections.featured-navigation.settings.active_background_color.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.settings.settings.background-color.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-bottom.label",
      "info": "t:sections.settings.settings.distance-bottom.info"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_spacing",
      "label": "t:sections.settings.settings.show-mobile-spacing.label"
    },
    {
      "type": "range",
      "id": "margin-top-mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-top-mobile.label",
      "visible_if": "{{ section.settings.show_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin-bottom-mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-bottom-mobile.label",
      "visible_if": "{{ section.settings.show_mobile_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-navigation.name",
      "category": "t:sections.categories.other",
      "blocks": []
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
