      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .val-particle {\n    position: fixed;\n    pointer-events: none;\n    font-size: 18px;\n    z-index: 9999;\n    animation: fadeFollow 1.6s ease-out forwards;\n    will-change: transform, opacity;\n    user-select: none;\n  }\n\n  @keyframes fadeFollow {\n    0% {\n      opacity: 1;\n      transform: translate(0, 0) scale(1);\n    }\n    100% {\n      opacity: 0;\n      transform: translate(var(--tx), var(--ty)) scale(0.6);\n    }\n  }\n\n  @media (max-width: 768px) {\n    .val-particle {\n      font-size: 15px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  'use strict';\n\n  const isMobile = window.matchMedia('(max-width: 768px)').matches;\n\n  /* 🎯 Emoji setleri */\n  const desktopParticles = [\n    { emoji: '🧴', weight: 35 },\n    { emoji: '❤️', weight: 30 },\n    { emoji: '🌸', weight: 25 },\n    { emoji: '✨', weight: 7 },\n    { emoji: '🎁', weight: 3 }\n  ];\n\n  const mobileParticles = [\n    { emoji: '❤️', weight: 40 },\n    { emoji: '🌸', weight: 35 },\n    { emoji: '✨', weight: 15 },\n    { emoji: '🎁', weight: 10 }\n  ];\n\n  const particles = isMobile ? mobileParticles : desktopParticles;\n\n  const maxParticles = isMobile ? 6 : 10;\n  const delay = isMobile ? 180 : 120;\n\n  let pool = [];\n  let lastTime = 0;\n\n  function initPool() {\n    for (let i = 0; i < maxParticles; i++) {\n      const el = document.createElement('span');\n      el.className = 'val-particle';\n      el.style.display = 'none';\n      document.body.appendChild(el);\n      pool.push(el);\n    }\n  }\n\n  function getFromPool() {\n    return pool.find(p => p.style.display === 'none');\n  }\n\n  function weightedEmoji() {\n    const bag = [];\n    particles.forEach(p => {\n      for (let i = 0; i < p.weight; i++) bag.push(p.emoji);\n    });\n    return bag[Math.floor(Math.random() * bag.length)];\n  }\n\n  function spawn(x, y) {\n    const el = getFromPool();\n    if (!el) return;\n\n    const emoji = weightedEmoji();\n    el.textContent = emoji;\n\n    /* 🎁 biraz daha yavaş & nadir his */\n    el.style.animationDuration = emoji === '🎁' ? '1.9s' : '1.6s';\n\n    const offsetX = (Math.random() - 0.5) * 20;\n    const offsetY = (Math.random() - 0.5) * 20;\n\n    el.style.setProperty('--tx', offsetX + 'px');\n    el.style.setProperty('--ty', offsetY + 'px');\n\n    el.style.left = x + 'px';\n    el.style.top = y + 'px';\n    el.style.display = 'block';\n\n    setTimeout(() => {\n      el.style.display = 'none';\n    }, 1800);\n  }\n\n  function handleMove(x, y) {\n    const now = Date.now();\n    if (now - lastTime > delay) {\n      spawn(x, y);\n      lastTime = now;\n    }\n  }\n\n  document.addEventListener('mousemove', e => {\n    if (!isMobile) handleMove(e.clientX, e.clientY);\n  }, { passive: true });\n\n  document.addEventListener('touchmove', e => {\n    if (isMobile && e.touches.length) {\n      const t = e.touches[0];\n      handleMove(t.clientX, t.clientY);\n    }\n  }, { passive: true });\n\n  document.addEventListener('touchstart', e => {\n    if (isMobile && e.touches.length) {\n      const t = e.touches[0];\n      handleMove(t.clientX, t.clientY);\n    }\n  }, { passive: true });\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', initPool);\n  } else {\n    initPool();\n  }\n})();\n</script>"
      }
    }
  },
