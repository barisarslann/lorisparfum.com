    "custom_liquid_JwzkYg": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign gift_product = settings.gift_select_test %}\n{% assign gift_product2 = settings.gift_select_test_2 %}\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", () => {\n// if(new URLSearchParams(window.location.search).get(\"test\")){\n\n  if(\n    document.querySelector(\".wt-cart__drawer__footer\")\n  ){\n    giftProducts();\n  }else{\n    var cartGiftCheckInterval = setInterval(() => {\n      if(\n        document.querySelector(\".wt-cart__drawer__footer\")\n      ){\n        giftProducts();\n        clearInterval(cartGiftCheckInterval);\n      }\n    }, 1000);\n  }\n\n// }\n});\n\nfunction giftProducts(){\n\n// .cart__contents .drawer__contents\ndocument.querySelector(\".wt-cart__drawer__footer\").insertAdjacentHTML(\n  \"afterbegin\", // afterend\n  `{% if gift_product != null %}\n  <div class=\"giftProducts\" style=\"margin-bottom: 8px;border: 1px solid #0002;padding: 5px 10px;\">\n  <span>\n  {% if request.locale.iso_code == \"tr\" %}\n  Hediye Seçenekleri:\n  {% elsif request.locale.iso_code == \"ar\" %}\n  خيارات الهدية:\n  {% else %}\n  Gift Options:\n  {% endif %}\n  </span>\n  <div>\n  <span>\n  <label for=\"giftProduct1\" onclick=\"giftAddCart({{ all_products[gift_product].selected_or_first_available_variant.id }}, 1, {{ all_products[gift_product].price }})\" style=\"display: grid;justify-items: center;text-align: center;\">\n  {% if all_products[gift_product].featured_image != null %}\n  <img style=\"height: 50px;display: block;\" src=\"{{ all_products[gift_product].featured_image | image_url: width: 200 }}\">\n  {% endif %}\n  {{ all_products[gift_product].title }} <span>{{ all_products[gift_product].price | money }}</span>\n  </label>\n  <input type=\"checkbox\" id=\"giftProduct1\" onclick=\"giftAddCart({{ all_products[gift_product].selected_or_first_available_variant.id }}, 1, {{ all_products[gift_product].price }})\" /><!-- type=\"radio\" name=\"giftSelect\" -->\n  </span>\n  {% if gift_product2 != null %}\n  <span>\n  <label for=\"giftProduct2\" onclick=\"giftAddCart({{ all_products[gift_product2].selected_or_first_available_variant.id }}, 2, {{ all_products[gift_product2].price }})\" style=\"display: grid;justify-items: center;text-align: center;\">\n  <img style=\"height: 50px;display: block;\" src=\"{{ all_products[gift_product2].featured_image | image_url: width: 200 }}\">\n  {{ all_products[gift_product2].title }} <span>{{ all_products[gift_product2].price | money }}</span>\n  </label>\n  <input type=\"checkbox\" id=\"giftProduct2\" onclick=\"giftAddCart({{ all_products[gift_product2].selected_or_first_available_variant.id }}, 2, {{ all_products[gift_product2].price }})\" />\n  </span>\n  {% endif %}\n  </div>\n  </div>\n  <style>\n.giftProducts div {\n  display: flex;\n  gap: 30px;\n  margin-top: 15px;\n}\n.giftProducts div span {\n  display: flex;\n  flex-direction: row-reverse;\n  gap: 10px;\n}\n.wt-cart__list li:has(.wt-cart__item__link[href*=\"hediye\" i][href*=\"ambalaj\" i]),\n.wt-cart__list li:has(.wt-cart__item__link[href*=\"hediye\" i][href*=\"kutu\" i]),\n.wt-cart__list li:has(.wt-cart__item__link[href*=\"hediye\" i][href*=\"paket\" i]) {\n  display: none;\n}\n  </style>\n  {% endif %}`\n);\n\nfetch(window.Shopify.routes.root + 'cart.js')\n.then(res => res.json())\n.then(data => {\n  var targetId = {{ all_products[gift_product].selected_or_first_available_variant.id }};\n  var targetId2 = {% if gift_product2 != null %}{{ all_products[gift_product2].selected_or_first_available_variant.id }}{% else %}9000{% endif %};\n  console.log(data);\n  if(\n    data.items.some(item => item.id === targetId) // data.items.filter(item => item.id === targetId).length\n  ){\n    document.querySelector(\".giftProducts #giftProduct1\").checked = true;\n    document.querySelector(\".wt-cart__subtotal__value\").dataset.giftPriceAdded = 1;\n  }else if(\n    data.items.some(item => item.id === targetId2)\n  ){\n    document.querySelector(\".giftProducts #giftProduct2\").checked = true;\n    document.querySelector(\".wt-cart__subtotal__value\").dataset.giftPriceAdded = 1;\n  }\n});\n\n}\n\nfunction giftAddCart(giftProductId, giftProductIndex, giftProductPrice){\n  var giftProductForm = new FormData();\n  if(\n    giftProductId\n  ){\n    giftProductForm.append(\"id\", giftProductId);\n  }\n  async function isInCart(targetIdParam) {\n    const res = await fetch(window.Shopify.routes.root + 'cart.js');\n    const data = await res.json();\n    return data.items.some(item => item.id === targetIdParam); // data.items.filter(item => item.id === targetIdParam).length\n  }\n  (async () => {\n  if(\n    giftProductIndex == 1\n  ){\n    if(document.querySelector(\".giftProducts #giftProduct2\")){\n      document.querySelector(\".giftProducts #giftProduct2\").checked = false;\n    }\n  }else{\n    document.querySelector(\".giftProducts #giftProduct1\").checked = false;\n  }\n  if(\n    // !document.querySelector('.js-counter-quantity[data-quantity-variant-id=\"' + {{ all_products[gift_product].selected_or_first_available_variant.id }} + '\"]')\n    !await isInCart(giftProductId)\n  ){\n    /* document.querySelector(\n      '.cart-item:has(.wt-cart__item__link[href*=\"?variant={{ all_products[gift_product].selected_or_first_available_variant.id }}\"]) .cart-page cart-remove-button'\n    )?.click(); */\n    fetch(\"/cart/change.js\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        id: String({{ all_products[gift_product].selected_or_first_available_variant.id }}),\n        quantity: 0\n      })\n    })\n    .then(res => res.json())\n    .then(data => console.log(\"Yeni Sepet:\", data));\n    {% if gift_product2 != null %}\n    fetch(\"/cart/change.js\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        id: String({{ all_products[gift_product2].selected_or_first_available_variant.id }}),\n        quantity: 0\n      })\n    })\n    .then(res => res.json())\n    .then(data => console.log(\"Yeni Sepet:\", data));\n    {% endif %}\n    fetch(\"https://lorisparfum.com/cart/add\", {\n      method: \"POST\",\n      credentials: \"include\",\n      body: giftProductForm\n    });\nif(typeof document.querySelector(\".wt-cart__subtotal__value\").dataset.giftPriceAdded == \"undefined\"){\n    document.querySelector(\".wt-cart__subtotal__value\").textContent =\n      (Number(document.querySelector(\".wt-cart__subtotal__value\").textContent.replace(\"TL\", \"\").replace(\",\", \"\").trim()) +\n      (giftProductPrice / 100)).toFixed(2) + \"TL\";\n    var cartNewCount = (Number(document.querySelector(\".wt-cart__drawer__header .wt-drawer__title__text\").textContent.replace(/\\D/g, \"\")) + 1);\n    document.querySelector(\".wt-cart__drawer__header .wt-drawer__title__text\").textContent =\n      \"Sepetiniz (\" +\n      cartNewCount +\n      \")\"; // (/[^0-9]/g)\n    document.querySelector(\".wt-header__panel__counter\").textContent = cartNewCount;\n}\ndocument.querySelector(\".wt-cart__subtotal__value\").dataset.giftPriceAdded = 1;\n  }else{\n    fetch(\"/cart/change.js\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        id: String(giftProductId),\n        quantity: 0\n      })\n    })\n    .then(res => res.json())\n    .then(data => console.log(\"Yeni Sepet:\", data));\nif(document.querySelector(\".wt-cart__subtotal__value\").dataset.giftPriceAdded == \"1\"){\n    document.querySelector(\".wt-cart__subtotal__value\").textContent =\n      (Number(document.querySelector(\".wt-cart__subtotal__value\").textContent.replace(\"TL\", \"\").replace(\",\", \"\").trim()) -\n      (giftProductPrice / 100) ).toFixed(2) + \"TL\";\n    var cartNewCount = (Number(document.querySelector(\".wt-cart__drawer__header .wt-drawer__title__text\").textContent.replace(/\\D/g, \"\")) - 1);\n    document.querySelector(\".wt-cart__drawer__header .wt-drawer__title__text\").textContent =\n      \"Sepetiniz (\" +\n      cartNewCount +\n      \")\"; // (/[^0-9]/g)\n    document.querySelector(\".wt-header__panel__counter\").textContent = cartNewCount;\n}\ndocument.querySelector(\".wt-cart__subtotal__value\").removeAttribute(\"data-gift-price-added\");\n  }\n  })();\n}\n\n</script>"
      }
    },
    "custom_liquid_7mq64c": {
