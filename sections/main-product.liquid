{{ 'component-product-fragrance-family.css' | asset_url | stylesheet_tag }}
{{ 'photoswipe.css' | asset_url | stylesheet_tag }}
{{ 'module-product-gallery.css' | asset_url | stylesheet_tag }}
{{ 'swiper.css' | asset_url | stylesheet_tag }}

{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_rgb = section.settings.text_color | color_to_rgb %}
{% assign pdp_nav_bg_rgb = section.settings.pdp_nav_icon_bg_color | color_to_rgb %}
{% assign pdp_nav_color_rgb = section.settings.pdp_nav_icon_color | color_to_rgb %}

<style>
  [id="shopify-section-{{ section.id }}"] {
    {% if section.settings['background_color'] != blank and section.settings['background_color'] != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-overlay-rgb: {{ section.settings.background_color | color_to_rgb | remove: 'rgb(' | remove: ')' }};
        --color-overlay-opacity: 1;
        --color-background: {{ section.settings.background_color }};
        --color-input-background: {{ section.settings.background_color }};
        --swiper-navigation-color: {{ section.settings.background_color }};
        --color-text-highlight: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.pdp_nav_icon_color != blank and section.settings.pdp_nav_icon_color != 'transparent' and pdp_nav_color_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --swiper-navigation-color: {{ section.settings.pdp_nav_icon_color }};
    {% endif %}
    {% if section.settings['background_color'] != blank and section.settings['background_color'] != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
    --sticky-button-bg: {{ section.settings.background_color | color_to_rgb | remove: 'rgb(' | remove: ')'}};
    {% else %}
      --sticky-button-bg: 255,255,255;
    {% endif %}
    --sticky-button-bg-opacity: {{ section.settings.sticky_bg_opacity | divided_by: 100.0 }} ;
    --sticky-button-bg-blur: {{ section.settings.sticky_bg_blur }}px;

    {% if section.settings['text_color'] != blank and section.settings['text_color'] != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.text_color }};
        --color-body-text: {{ section.settings.text_color }};
        --color-border: {{ section.settings.text_color }};
        --inactive-border-opacity: 0.2;
        --custom-section-color-border: {{ section.settings.text_color }};
        --color-price: {{ section.settings.text_color }};
        --color-brand: {{ section.settings.text_color }};
        --color-body-text: {{ section.settings.text_color }};
        --color-bullet: {{ section.settings.text_color }};
        --color-links-active: {{ section.settings.text_color }};
        --color-links: {{ section.settings.text_color }};
        --color-input-border: {{ section.settings.text_color }};
        --color-input-text: {{ section.settings.text_color }};
        --color-input-placeholder: {{ section.settings.text_color }};
        --color-body-text: {{ section.settings.text_color }};
        --swiper-theme-color: {{ section.settings.text_color }};

        .wt-slider__container {
          --color-border: {{ section.settings.text_color }};
        }
    {% endif %}

    {% if section.settings.margin-top %}
        --section-gap-top: {{ section.settings.margin-top }}px;
    {% endif %}

    {% if section.settings.margin-bottom %}
        --section-gap-bottom: {{ section.settings.margin-bottom }}px;
    {% endif %}

      {%- if section.settings.show_mobile_spacing -%}
          --section-gap-top-mobile: {{ section.settings.margin-top-mobile }}px;
      {%- endif -%}

      {%- if section.settings.show_mobile_spacing -%}
          --section-gap-bottom-mobile: {{ section.settings.margin-bottom-mobile }}px;
      {%- endif -%}

    {% if section.settings.desktop-image-ratio == 'square' %}
        --aspect-ratio: 1/1;
    {% endif %}
    {% if section.settings.desktop-image-ratio == 'portrait' %}
        --aspect-ratio: var(--aspect-ratio-portait);
    {% endif %}
    {% if section.settings.desktop-image-ratio == 'original' %}
        --aspect-ratio: auto;
    {% endif %}

        .wt-product__img {
          {%- case section.settings.desktop-image-ratio -%}
          {% when 'square'%}
              --aspect-ratio: 1/1;
          {% when 'portrait' %}
              --aspect-ratio: var(--aspect-ratio-portait);
          {% endcase %}
        }
  }

  {%- liquid
    assign has_pdp_nav_colors = false
    if section.settings.pdp_nav_icon_bg_color != blank and section.settings.pdp_nav_icon_bg_color != 'transparent' and pdp_nav_bg_rgb != 'rgba(0, 0, 0, 0.0)'
      assign has_pdp_nav_colors = true
    endif
    if section.settings.background_color != blank and section.settings.background_color != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)'
      assign has_pdp_nav_colors = true
    endif
    if section.settings.pdp_nav_icon_color != blank and section.settings.pdp_nav_icon_color != 'transparent' and pdp_nav_color_rgb != 'rgba(0, 0, 0, 0.0)'
      assign has_pdp_nav_colors = true
    endif
  -%}
  {% if has_pdp_nav_colors %}
    [id="shopify-section-{{ section.id }}"] .wt-slider__nav-btn.swiper-button-next.wt-slider__nav-next,
    [id="shopify-section-{{ section.id }}"] .wt-slider__nav-btn.swiper-button-prev.wt-slider__nav-prev {
      {% if section.settings.pdp_nav_icon_bg_color != blank and section.settings.pdp_nav_icon_bg_color != 'transparent' and pdp_nav_bg_rgb != 'rgba(0, 0, 0, 0.0)' %}
      background: rgba({{ section.settings.pdp_nav_icon_bg_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' }}, {{ section.settings.pdp_nav_icon_bg_opacity | divided_by: 100.0 }});
      {% endif %}
      {% if section.settings.pdp_nav_icon_color != blank and section.settings.pdp_nav_icon_color != 'transparent' and pdp_nav_color_rgb != 'rgba(0, 0, 0, 0.0)' %}
      color: {{ section.settings.pdp_nav_icon_color }};
      {% elsif section.settings['background_color'] != blank and section.settings['background_color'] != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
      color: {{ section.settings.background_color }};
      {% endif %}
    }
    {% if section.settings.pdp_nav_icon_bg_color != blank and section.settings.pdp_nav_icon_bg_color != 'transparent' and pdp_nav_bg_rgb != 'rgba(0, 0, 0, 0.0)' %}
    [id="shopify-section-{{ section.id }}"] .wt-slider__nav-btn.swiper-button-next.wt-slider__nav-next:hover,
    [id="shopify-section-{{ section.id }}"] .wt-slider__nav-btn.swiper-button-prev.wt-slider__nav-prev:hover {
      background: rgba({{ section.settings.pdp_nav_icon_bg_color | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' }}, min(1, calc({{ section.settings.pdp_nav_icon_bg_opacity | divided_by: 100.0 }} + 0.1)));
    }
    {% endif %}
  {% endif %}

  {%- for block in section.blocks -%}
    {%- render 'pdp-block-css', block: block, product: product -%}
  {%- endfor -%}
</style>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'btn-price.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'subscription-widget.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'variants.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'drawer-select.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'model_element.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'variant-dropdown.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'add-to-recently-viewed.js' | asset_url }}" defer="defer"></script>

<add-to-recently-viewed data-handle="{{- product.handle -}}" data-shop-id="{{- shop.id -}}"></add-to-recently-viewed>

{% comment %} ar models script {% endcomment %}
{% render 'ar-models-support', product: product %}


{% assign selected_variant = product.selected_variant %}
{% assign enabled_preselect = false %}
{% if section.settings['enable-preselected-variant'] and selected_variant == blank %}
  {% assign selected_variant = product.selected_or_first_available_variant %}
  {% assign enabled_preselect = true %}
{% endif %}

{% assign is_even = product.media.size | modulo: 2 %}
{% if is_even == 0 %}
  {% assign even_or_odd_class = 'odd' %}
{% else %}
  {% assign even_or_odd_class = 'even' %}
{% endif %}

{% if section.settings['desktop-layout'] == 'carousel-vertical' %}
  {% assign desktop_layout = 'carousel-vertical' %}
  {% assign thumbnails_direction = 'vertical' %}
{% elsif section.settings['desktop-layout'] == 'carousel-horizontal' %}
  {% assign desktop_layout = 'carousel-horizontal' %}
  {% assign thumbnails_direction = 'horizontal' %}
{% elsif section.settings['desktop-layout'] == 'collage' %}
  {% assign desktop_layout = 'collage' %}
{% elsif section.settings['desktop-layout'] == 'masonry' %}
  {% assign desktop_layout = 'masonry' %}
{% elsif section.settings['desktop-layout'] == 'fashion' %}
  {% assign desktop_layout = 'masonry' %}
{% endif %}

{% if section.settings['full-width-enabled'] %}
  {% assign wrapper_class = 'wt-product__wrapper--full' %}
{% else %}
  {% assign wrapper_class = '' %}
{% endif %}

{% assign fashion_type = 'fashion' %}

{% comment %} TODO: add conditions for collage galleries and images in 2 columns {% endcomment %}
{%liquid
  assign img_sizes = "(min-width: 2560px) 1280px, (min-width: 900px) 56vw, 100vw"

  assign media_size = section.settings.desktop-media-size

  assign full_width = false
  if section.settings['full-width-enabled']
    assign full_width = true
  endif

  if desktop_layout == 'carousel-horizontal' and media_size == 'normal'
    assign img_sizes = "(min-width: 1600px) 820px, (min-width: 900px) 52vw, 100vw"
  endif
  if desktop_layout == 'carousel-horizontal' and media_size == 'large'
    assign img_sizes = "(min-width: 1600px) 1040px, (min-width: 1200px) 65vw, (min-width: 900px) 57vw, 100vw"
  endif

  if desktop_layout == 'masonry' and media_size == 'normal'
    assign img_sizes = "(min-width: 1600px) 400px, (min-width: 1200px) 25vw, (min-width: 900px) 52vw, 100vw"
    if full_width
      assign img_sizes = "(min-width: 2560px) 700px, (min-width: 1200px) 40vw, (min-width: 900px) 52vw, 100vw"
    endif
  endif
  if desktop_layout == 'masonry' and media_size == 'large'
    assign img_sizes = "(min-width: 1600px) 664px, (min-width: 1200px) 33vw, (min-width: 900px) 57vw, 100vw"
    if full_width
      assign img_sizes = "(min-width: 2560px) 940px, (min-width: 1600px) 37vw, (min-width: 1200px) 33vw, (min-width: 900px) 57vw, 100vw"
    endif
  endif

  if desktop_layout == 'collage' and media_size == 'normal'
    assign img_sizes = "(min-width: 1600px) 810px, (min-width: 1200px) 50vw, (min-width: 900px) 52vw, 100vw"
    if full_width
      assign img_sizes = "(min-width: 2560px) 1440px, (min-width: 900px) 52vw, 100vw"
    endif
  endif
  if desktop_layout == 'collage' and media_size == 'large'
    assign img_sizes = "(min-width: 1600px) 1040px, (min-width: 1200px) 65vw, (min-width: 900px) 57vw, 100vw"
    if full_width
      assign img_sizes = "(min-width: 2560px) 1840px, (min-width: 1200px) 72vw, (min-width: 900px) 57vw, 100vw"
    endif
  endif

  if desktop_layout == 'carousel-vertical' and media_size == 'large'
    assign img_sizes = "(min-width: 1600px) 940px, (min-width: 1200px) 60vw, (min-width: 900px) 50vw, 100vw"
  endif
  if desktop_layout == 'carousel-vertical' and media_size == 'normal'
    assign img_sizes = "(min-width: 1600px) 720px, (min-width: 900px) 50vw, 100vw"
  endif

  if section.settings['desktop-layout'] == 'fashion'
    assign img_sizes = "(min-width: 2560px) 1280px, (min-width: 900px) 50vw, 100vw"
  endif
%}

{% if section.settings['desktop-layout'] == fashion_type %}
  {% comment %} Applies gallery-fashion's transparent header and section offset before first paint to avoid the jump/flash pdp.js causes as a deferred module (#3063). {% endcomment %}
  <script>
    (function initFashionHero() {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      const wtHeader = document.querySelector('.wt-header');
      const header = document.querySelector('header');
      if (!section || !wtHeader || !header) return;

      const transparentHeaderEnabled =
        wtHeader.dataset.transparent && wtHeader.classList.contains('wt-header--v3');
      if (!transparentHeaderEnabled) return;

      wtHeader.classList.add('wt-header--fashion-transparent');

      const isFirstSection = document.querySelector('#root').querySelector('section') === section;
      if (isFirstSection) {
        const offset = header.offsetHeight;
        if (offset) section.style.marginTop = '-' + offset + 'px';
      }
    })();
  </script>
  <gallery-fashion
    class="gallery-fashion"
  >
{% endif %}

{% assign show_thumbs_on_mobile = false %}
{% if section.settings['show-thumbnails-mobile'] %}
    {% if section.settings['desktop-layout'] == 'carousel-vertical' or section.settings['desktop-layout'] == 'carousel-horizontal' %}
        {% assign show_thumbs_on_mobile = true %}
    {% endif %}
{% endif %}

<section
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
  class="wt-product__wrapper {{ wrapper_class }} wt-product__wrapper--{{ section.settings.desktop-layout }}"
  desktop-media-size="{% if section.settings.desktop-layout != 'fashion' %}{{ section.settings.desktop-media-size }}{% else %}normal{% endif %}"
  desktop-layout="{{ section.settings.desktop-layout }}"
  mobile-image-size="{{ section.settings.mobile-image }}"
  desktop-ratio="{{ section.settings.desktop-image-ratio }}"
>
  <div class="wt-product wt-product--{{ desktop_layout }}">
    {% render 'product-head' %}

    <gallery-section
      id="MediaGallery-{{ section.id }}"
      class="
        {% if product.media.size > 1 %}loading{% endif %}
        {% if show_thumbs_on_mobile %}wt-product__gallery--thumbs-mobile{% endif %}
        swiper
        wt-product__gallery
        wt-product__gallery--{{ desktop_layout }}
        wt-product__gallery--{{ even_or_odd_class }}
        wt-product__slider--padding
        {% if product.media.size == 1 %} wt-product__gallery--single{% endif %}
      "
      desktop-ratio="{{ section.settings.desktop-image-ratio }}"
      data-product-page
    >
      {% if product.media.size > 1 %}
        <div id="gallery-loader" class="wt-product__gallery__loader">
          {% render 'loader' %}
        </div>
      {% endif %}

      <script data-configuration type="text/json">
        {
          "sliderEnabledBreakpoint": "1200",
          "desktopLayout": "{{ desktop_layout }}"
        }
      </script>

      <div data-gallery class="{% if section.settings.enable-image-zoom %}photoswipe{% endif %}">
        <div class="card__badges card__badges--product">
          {% render 'loris-product-badges', product: product, large: true %}
        </div>
        <ul
          data-swiper-container
          class="{% if desktop_layout == 'masonry' %}swiper-wrapper--masonry{% elsif desktop_layout == 'fashion' %}swiper-wrapper--masonry{% else %}swiper-wrapper{% endif %}"
          desktop-layout="{{ desktop_layout }}"
        >
          {%- if selected_variant.featured_media != null -%}
            {%- assign featured_media = selected_variant.featured_media -%}

            <li
              data-swiper-slide
              data-media-id="{{ featured_media.id }}"
              class="swiper-slide"
              style="--slide-ratio: {{ featured_media.preview_image.aspect_ratio }}"
            >
              {%- if featured_media.media_type == 'image' -%}
                {% if section.settings['enable-image-zoom'] -%}
                  <a
                    href="{{ featured_media.preview_image | image_url: width: 4096 }}"
                    data-pswp-width="{{ featured_media.width }}"
                    data-pswp-height="{{ featured_media.height }}"
                    target="_blank"
                    tabindex="0"
                  >
                {%- endif %}
                <img
                  srcset="
                    {%- if featured_media.preview_image.width >= 500 -%}{{ featured_media.preview_image | image_url: width: 500 }} 500w,{%- endif -%}
                    {%- if featured_media.preview_image.width >= 750 -%}{{ featured_media.preview_image | image_url: width: 750 }} 750w,{%- endif -%}
                    {%- if featured_media.preview_image.width >= 1000 -%}{{ featured_media.preview_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                    {%- if featured_media.preview_image.width >= 1200 -%}{{ featured_media.preview_image | image_url: width: 1200 }} 1200w,{%- endif -%}
                    {%- if featured_media.preview_image.width >= 1680 -%}{{ featured_media.preview_image | image_url: width: 1680 }} 1680w,{%- endif -%}
                    {%- if featured_media.preview_image.width >= 2048 -%}{{ featured_media.preview_image | image_url: width: 2048 }} 2048w,{%- endif -%}
                    {%- if featured_media.preview_image.width >= 4096 -%}{{ featured_media.preview_image | image_url: width: 4096 }} 4096w{%- endif -%}
                  "
                  sizes="{{ img_sizes }}"
                  src="{{ featured_media.preview_image | image_url: width: 500 }}"
                  alt="{{ featured_media.preview_image.alt | default: product.title | escape }}"
                  width="1100"
                  fetchpriority="high"
                  height="{{ 1100 | divided_by: featured_media.preview_image.aspect_ratio | ceil }}"
                  data-media-id="{{ featured_media.id }}"
                  class="wt-product__img {% if section.settings.enable-image-zoom %} wt-product__img--zoom-cursor {% endif %}"
                >
                {% if section.settings['enable-image-zoom'] %}</a>{% endif %}
              {%- endif -%}
            </li>
          {%- endif -%}
          {% for media in product.media %}
            {%- unless media.id == selected_variant.featured_media.id -%}
              <li
                data-swiper-slide
                data-media-id="{{ media.id }}"
                data-model="{% if media.media_type == 'model' %}true{% endif %}"
                class="swiper-slide"
                id="image-{{ forloop.index }}"
                {% if media.media_type != 'model' %}
                style="--slide-ratio: {{ media.preview_image.aspect_ratio }}"
                {% endif %}
              >
                {%- if media.media_type == 'image' -%}
                  {% if section.settings['enable-image-zoom'] -%}
                    <a
                      href="{{ media | image_url: width: 4096 }}"
                      data-pswp-width="{{ media.width }}"
                      data-pswp-height="{{ media.height }}"
                      target="_blank"
                      tabindex="0"
                    >
                  {% endif %}
                  <img
                    srcset="
                      {%- if media.preview_image.width >= 500 -%}{{ media.preview_image | image_url: width: 500 }} 500w,{%- endif -%}
                      {%- if media.preview_image.width >= 750 -%}{{ media.preview_image | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if media.preview_image.width >= 1000 -%}{{ media.preview_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                      {%- if media.preview_image.width >= 1200 -%}{{ media.preview_image | image_url: width: 1200 }} 1200w,{%- endif -%}
                      {%- if media.preview_image.width >= 1680 -%}{{ media.preview_image | image_url: width: 1680 }} 1680w,{%- endif -%}
                      {%- if media.preview_image.width >= 2048 -%}{{ media.preview_image | image_url: width: 2048 }} 2048w,{%- endif -%}
                      {%- if media.preview_image.width >= 4096 -%}{{ media.preview_image | image_url: width: 4096 }} 4096w{%- endif -%}
                    "
                    sizes="{{ img_sizes }}"
                    src="{{ media.preview_image | image_url: width: 600 }}"
                    alt="{{ media.preview_image.alt | default: product.title | escape }}"
                    width="1100"
                    height="{{ 1100 | divided_by: media.preview_image.aspect_ratio | ceil }}"
                    data-media-id="{{ media.id }}"
                    class="wt-product__img  {% if section.settings.enable-image-zoom %} wt-product__img--zoom-cursor {% endif %}"
                    {% if forloop.index > 1 %}
                      loading="lazy"
                    {% else %}
                      fetchpriority="high"
                    {% endif %}
                  >
                  {% if section.settings['enable-image-zoom'] %}</a>{% endif %}
                {%- endif -%}

                {% if media.media_type == 'video' %}
                    {%- liquid
                      assign play_pause_button = false
                      assign unmute_button = false
                      assign custom_controls = false

                      if section.settings.video_controls == false and section.settings.video_custom_play_controls == true
                        assign play_pause_button = true
                      endif
                      if section.settings.video_controls == false and section.settings.video_custom_mute_controls == true
                        assign unmute_button = true
                      endif
                      if section.settings.video_controls == false
                        if play_pause_button or unmute_button
                          assign custom_controls = true
                        endif
                      endif

                      assign pswp_video_src = ''
                      for vid in media.sources
                        if pswp_video_src == '' and vid.mime_type == 'video/mp4'
                          assign pswp_video_src = vid.url
                        endif
                      endfor
                      if pswp_video_src == ''
                        assign pswp_video_src = media.sources[0].url
                      endif
                    -%}

                  {% if section.settings['enable-image-zoom'] and section.settings.video_controls %}
                    <a href="{{ media.preview_image | image_url: width: 1200 }}" data-pswp-type="video" data-video-src="{{ pswp_video_src }}" data-video-controls="true" class="wt-pswp-overlay-link" tabindex="-1" aria-hidden="true"></a>
                  {% elsif section.settings['enable-image-zoom'] %}
                    <a href="{{ media.preview_image | image_url: width: 1200 }}" data-pswp-type="video" data-video-src="{{ pswp_video_src }}" data-video-controls="false" tabindex="0">
                  {% endif %}
                  <div
                      class="wt-product__thumbnail-video wt-product__slide-media"
                      tabindex="-1"
                  >
                   {% if custom_controls %}
                   <script src="{{ 'video-controls.js' | asset_url }}" defer="defer"></script>
                   <video-controls>
                   {% endif %}

                   {% if section.settings.video_controls == false %}
                   <div class="wt-video__overlay">
                    <div class="wt-video__overlay__controls">
                    {% if play_pause_button %}
                       {% render 'play-pause-button' %}
                     {% endif %}
                     {% if unmute_button %}
                       {% render 'unmute-button' %}
                     {% endif %}
                    </div>
                   </div>
                   {% endif %}
                    <video
                      class="wt-video__movie wt-video__item {% if section.settings.video_controls %}wt-video__item--native-controls{% endif %}"
                      playsinline
                      {% if section.settings.enable_video_looping %}
                        loop="loop"
                      {% endif %}
                      autoplay="autoplay"
                      muted="muted"
                      alt="{{ media.alt | default: product.title | escape }}"
                      data-media-id="{{ media.id }}"
                      poster="{{ media.preview_image.src | image_url: width: 900 }}"
                      style="width: 100%; aspect-ratio: {{ media.aspect_ratio }}"
                      {% if section.settings.video_controls  %}controls{% endif %}
                      tabindex="0"
                    >
                      {% for vid in media.sources %}
                        <source src="{{ vid.url }}" type="{{ vid.mime_type }}">
                      {% endfor %}
                     </video>
                     {% if custom_controls %}
                     </video-controls>
                     {% endif %}
                  </div>
                  {% if section.settings['enable-image-zoom'] and section.settings.video_controls == false %}</a>{% endif %}
                  {% if section.settings['enable-image-zoom'] and custom_controls %}
                    <template class="wt-pswp-video-controls-template">
                      {% if play_pause_button %}{% render 'play-pause-button' %}{% endif %}
                      {% if unmute_button %}{% render 'unmute-button' %}{% endif %}
                    </template>
                  {% endif %}
                {% endif %}

                {% if media.media_type == 'external_video' %}
                  {% if media.host == 'youtube' %}
                    <model-element
                      tabindex="-1"
                      class="wt-product__slide-media"
                    >
                      <div class="model-media__container" tabindex="-1">
                        <button
                          aria-label="{{ 'aria-label.main-product-video' | t }}"
                          class="model-btn"
                          tabindex="0"
                        >
                          {% render 'icon-play' %}
                        </button>
                        <img
                          srcset="
                            {%- if media.preview_image.width >= 500 -%}{{ media.preview_image | image_url: width: 500 }} 500w,{%- endif -%}
                            {%- if media.preview_image.width >= 750 -%}{{ media.preview_image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if media.preview_image.width >= 1000 -%}{{ media.preview_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                            {%- if media.preview_image.width >= 1200 -%}{{ media.preview_image | image_url: width: 1200 }} 1200w,{%- endif -%}
                            {%- if media.preview_image.width >= 1680 -%}{{ media.preview_image | image_url: width: 1680 }} 1680w,{%- endif -%}
                            {%- if media.preview_image.width >= 2048 -%}{{ media.preview_image | image_url: width: 2048 }} 2048w,{%- endif -%}
                            {%- if media.preview_image.width >= 4096 -%}{{ media.preview_image | image_url: width: 4096 }} 4096w{%- endif -%}
                          "
                          sizes="{{ img_sizes }}"
                          src="{{ media.preview_image | image_url: width: 600 }}"
                          alt="{{ media.alt | default: product.title | escape }}"
                          width="1100"
                          height="{{ 1100 | divided_by: media.preview_image.aspect_ratio | ceil }}"
                          data-media-id="{{ media.id }}"
                          class="wt-product__img"
                          loading="lazy"
                        >
                      </div>
                      <div class="hidden">
                        <iframe
                          src="https://www.youtube.com/embed/{{ media.external_id }}?autoplay=0&mute=0&controls=2{% if section.settings.enable_video_looping %}&loop=1&playlist={{ media.external_id }}{% endif %}"
                          frameborder="0"
                          class="wt-video__movie wt-video__item"
                          allow="autoplay; encrypted-media"
                          title="{{ 'aria-label.main-product-yt' | t }}"
                        ></iframe>
                      </div>
                    </model-element>
                  {% endif %}

                  {% if media.host == 'vimeo' %}
                    <model-element
                      tabindex="-1"
                      class="wt-product__slide-media"
                    >
                      <div class="model-media__container">
                        <button
                          aria-label="{{ 'aria-label.main-product-video' | t }}"
                          class="model-btn"
                          tabindex="0"
                        >
                          {% render 'icon-play' %}
                        </button>
                        <img
                          srcset="
                            {%- if media.preview_image.width >= 500 -%}{{ media.preview_image | image_url: width: 500 }} 500w,{%- endif -%}
                            {%- if media.preview_image.width >= 750 -%}{{ media.preview_image | image_url: width: 750 }} 750w,{%- endif -%}
                            {%- if media.preview_image.width >= 1000 -%}{{ media.preview_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                            {%- if media.preview_image.width >= 1200 -%}{{ media.preview_image | image_url: width: 1200 }} 1200w,{%- endif -%}
                            {%- if media.preview_image.width >= 1680 -%}{{ media.preview_image | image_url: width: 1680 }} 1680w,{%- endif -%}
                            {%- if media.preview_image.width >= 2048 -%}{{ media.preview_image | image_url: width: 2048 }} 2048w,{%- endif -%}
                            {%- if media.preview_image.width >= 4096 -%}{{ media.preview_image | image_url: width: 4096 }} 4096w{%- endif -%}
                          "
                          sizes="{{ img_sizes }}"
                          src="{{ media.preview_image | image_url: width: 600 }}"
                          alt="{{ media.alt | default: product.title | escape }}"
                          loading="lazy"
                          width="1100"
                          height="{{ 1100 | divided_by: media.preview_image.aspect_ratio | ceil }}"
                          data-media-id="{{ media.id }}"
                          class="wt-product__img"
                        >
                      </div>
                      <div class="hidden">
                        <iframe
                          src="https://player.vimeo.com/video/{{ media.external_id }}?background=0&controls=1{% if section.settings.enable_video_looping %}&loop=1{% endif %}"
                          frameborder="0"
                          class="js-vimeo wt-video__movie wt-video__item"
                          allow="encrypted-media"
                          title="{{ 'aria-label.main-product-vimeo' | t }}"
                        ></iframe>
                      </div>
                    </model-element>
                  {% endif %}
                {% endif %}
                {% if media.media_type == 'model' %}
                  <model-element
                    tabindex="-1"
                    class="wt-product__slide-media"
                  >
                    <div class="model-media__container" tabindex="-1">
                      <button
                        aria-label="{{ 'aria-label.main-product-3d-model' | t }}"
                        class="model-btn"
                        tabindex="0"
                      >
                        {% render 'icon-3d-model' %}
                      </button>
                      <img
                        srcset="
                          {%- if media.preview_image.width >= 500 -%}{{ media.preview_image | image_url: width: 500 }} 500w,{%- endif -%}
                          {%- if media.preview_image.width >= 750 -%}{{ media.preview_image | image_url: width: 750 }} 750w,{%- endif -%}
                          {%- if media.preview_image.width >= 1000 -%}{{ media.preview_image | image_url: width: 1000 }} 1000w,{%- endif -%}
                          {%- if media.preview_image.width >= 1200 -%}{{ media.preview_image | image_url: width: 1200 }} 1200w,{%- endif -%}
                          {%- if media.preview_image.width >= 1680 -%}{{ media.preview_image | image_url: width: 1680 }} 1680w,{%- endif -%}
                          {%- if media.preview_image.width >= 2048 -%}{{ media.preview_image | image_url: width: 2048 }} 2048w,{%- endif -%}
                          {%- if media.preview_image.width >= 4096 -%}{{ media.preview_image | image_url: width: 4096 }} 4096w{%- endif -%}
                        "
                        sizes="{{ img_sizes }}"
                        src="{{ media.preview_image | image_url: width: 600 }}"
                        alt="{{ media.preview_image.alt | escape }}"
                        loading="lazy"
                        width="1100"
                        height="{{ 1100 | divided_by: media.preview_image.aspect_ratio | ceil }}"
                        data-media-id="{{ media.id }}"
                        class="wt-product__img"
                      >
                    </div>
                    <div class="hidden">{{ media | model_viewer_tag: image_size: '600x' }}</div>
                    <button
                      class="wt-button wt-button--full-width product__xr-button"
                      type="button"
                      aria-label="{{ 'products.product.xr_button_label' | t }}"
                      data-shopify-xr
                      data-shopify-model3d-id="{{ media.id }}"
                      data-shopify-title="{{ product.title | escape }}"
                      data-shopify-xr-hidden
                    >
                      {% render 'icon-3d-model' %}
                      {{ 'products.product.xr_button' | t }}
                    </button>
                  </model-element>
                {% endif %}
              </li>
            {%- endunless -%}
          {% endfor %}
        </ul>

        {% if product.media.size > 1 %}
          <div class="swiper-button-next wt-slider__nav-btn wt-slider__nav-next wt-slider__nav-next--basic">
            {% render 'icons', id: 'arrow-right' %}
          </div>
          <div class="swiper-button-prev wt-slider__nav-btn wt-slider__nav-prev wt-slider__nav-prev--basic">
            {% render 'icons', id: 'arrow-left' %}
          </div>
          <div class="swiper-scrollbar wt-slider__scrollbar wt-slider__scrollbar--featured"></div>

          <div class="swiper-pagination"></div>
        {% endif %}

        <script data-swiper-configuration type="text/json">
          {
            "grabCursor": true,
            "autoHeight": true,
            "spaceBetween": 8,
            "navigation": {
              "nextEl": ".wt-slider__nav-next",
              "prevEl": ".wt-slider__nav-prev"
            },
            "scrollbar": {
              "el": ".wt-slider__scrollbar--featured",
              "draggable": true
            },
            "pagination": {
              "el": ".swiper-pagination",
              "type": "fraction"
            }
          }
        </script>
      </div>

      <div data-thumbs {% if show_thumbs_on_mobile %}data-thumbs-mobile{% endif %}>
        <ul data-swiper-container class="thumbs-list" aria-live="polite">
          {%- if selected_variant.featured_media != null -%}
            {%- assign featured_media = selected_variant.featured_media -%}

            {%- liquid
              assign thumb_ratio = featured_media.preview_image.aspect_ratio
              if section.settings['desktop-image-ratio'] == 'square'
                assign thumb_ratio = 1
              elsif section.settings['desktop-image-ratio'] == 'portrait'
                assign thumb_ratio = 'var(--aspect-ratio-portait)'
              endif
            %}

            <li
              data-swiper-slide
              class="thumbs-list-item"
              data-slide-media-id="{{ featured_media.id }}"
              style="--thumb-ratio: {{ thumb_ratio }};"
              tabindex="-1"
            >
              <div
                {% if featured_media.media_type == 'video' or featured_media.media_type == 'external_video' %}
                  class="wt-product__thumbnail-video"
                {% endif %}
              >
                <img
                  src="{{ featured_media.preview_image | image_url: width: 300 }}"
                  alt="{{ featured_media.preview_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="300"
                  height="{{ 300 | divided_by: featured_media.preview_image.aspect_ratio | ceil }}"
                  data-media-id="{{ media.id }}"
                  class="wt-product__img"
                >
                {% if featured_media.media_type == 'video' or featured_media.media_type == 'external_video' %}
                  <div class="wt-product__thumbnail-video__icon">{% render 'icon-play' %}</div>
                {% endif %}
              </div>
            </li>
          {%- endif -%}

          {% for media in product.media %}
            {%- unless media.id == selected_variant.featured_media.id -%}
              {%- liquid
                assign thumb_ratio = media.preview_image.aspect_ratio
                if section.settings['desktop-image-ratio'] == 'square'
                  assign thumb_ratio = 1
                elsif section.settings['desktop-image-ratio'] == 'portrait'
                  assign thumb_ratio = 'var(--aspect-ratio-portait)'
                endif
              %}

              <li
                data-swiper-slide
                class="thumbs-list-item"
                data-slide-media-id="{{ media.id }}"
                style="--thumb-ratio: {{ thumb_ratio }};"
                tabindex="-1"
              >
                <div
                  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                    class="wt-product__thumbnail-video"
                  {% endif %}
                >
                  <img
                    src="{{ media.preview_image | image_url: width: 300 }}"
                    alt="{{ media.preview_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="300"
                    height="{{ 300 | divided_by: media.preview_image.aspect_ratio | ceil }}"
                    data-media-id="{{ media.id }}"
                    class="wt-product__img"
                  >
                  {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                    <div class="wt-product__thumbnail-video__icon">{% render 'icon-play' %}</div>
                  {% endif %}
                </div>
              </li>

              {% assign thumbCounter = thumbCounter | plus: 1 %}
            {%- endunless -%}
          {% endfor %}
        </ul>

        <div class="swiper-button-next wt-slider__nav-btn wt-slider__nav-next wt-slider__nav-next--basic">
          {% render 'icons', id: 'arrow-right' %}
        </div>
        <div class="swiper-button-prev wt-slider__nav-btn wt-slider__nav-prev wt-slider__nav-prev--basic">
          {% render 'icons', id: 'arrow-left' %}
        </div>

        <script data-swiper-configuration type="text/json">
          {
              "freeMode": false,
              "speed": 150,
              "direction": "{{ thumbnails_direction }}",
              "spaceBetween": 8,
              {% if desktop_layout == 'carousel-vertical' %}
                  "slidesPerView": {% if section.settings.desktop-image-ratio == 'portrait' %} 7 {% else %} 6 {% endif %},
                  "slidesPerGroup": {% if section.settings.desktop-image-ratio == 'portrait' %} 5 {% else %} 4 {% endif %},
              {%  else %}
                  "slidesPerView": "auto",
                  "slidesPerGroup": 4,
              {% endif %}
              "watchSlidesVisibility": true,
              "watchSlidesProgress": true,
              "watchOverflow": true,
              "slideToClickedSlide": true,
              "loopedSlides": 0,
              "navigation": {
                "nextEl": ".wt-slider__nav-next",
                "prevEl": ".wt-slider__nav-prev"
              },
              "breakpoints": {
                "0": {
                  "direction": "horizontal",
                  "slidesPerView": "auto",
                  "slidesPerGroup": 5,
                  "freeMode": true,
                  "slidesOffsetBefore": 16,
                  "slidesOffsetAfter": 16
                },
                "901": {
                  "direction": "{{ thumbnails_direction }}",
                  "slidesOffsetBefore": 0,
                  "slidesOffsetAfter": 0
                }
              }
          }
        </script>
      </div>
    </gallery-section>

    <section class="wt-product__main rte">
      <div class="wt-product__info product__info-container">
        {%- assign product_form_id = 'product-form-' | append: section.id -%}
        {%- assign collapsible_drawer_exist = false -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'collapsible_drawer' -%}
            {%- assign collapsible_drawer_exist = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- liquid
          assign initial_sp_price = nil
          assign initial_sp_compare_at_price = nil
          if product.selling_plan_groups.size > 0
            for b in section.blocks
              if b.type == 'subscription_widget' and b.settings.plan_order != 'one_time_first'
                assign initial_sp_price = product.selected_or_first_available_variant.selling_plan_allocations.first.price
                assign initial_sp_compare_at_price = product.selected_or_first_available_variant.selling_plan_allocations.first.compare_at_price
                break
              endif
            endfor
          endif
          assign initial_button_price = initial_sp_price | default: product.selected_or_first_available_variant.price
        -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'bulletpoints' -%}
              {% render 'pdp-block-bulletpoints', block: block, product: product %}
            {%- when 'button' -%}
              {% render 'pdp-block-button', block: block, section: section %}
            {%- when 'buy_buttons' -%}
              {% render 'pdp-block-buy-buttons', block: block, section: section, product: product, product_form_id: product_form_id, selected_variant: selected_variant, enabled_preselect: enabled_preselect, initial_button_price: initial_button_price %}
            {%- when 'collapsible_drawer' -%}
              {% render 'pdp-block-collapsible-drawer', block: block, section: section, product: product %}
            {%- when 'collapsible_file_row' -%}
              {% render 'pdp-block-collapsible-file-row', block: block, section: section, product: product %}
            {%- when 'collapsible_tab' -%}
              {% render 'pdp-block-collapsible-tab', block: block, section: section, product: product %}
            {%- when 'complementary' -%}
              {% render 'pdp-block-complementary', block: block, section: section, product: product %}
            {%- when 'countdown_discount' -%}
              {% render 'pdp-block-countdown-discount', block: block %}
            {%- when 'custom_liquid' -%}
              {{ block.settings.custom_liquid }}
            {%- when 'loris_campaigns' -%}
              {% render 'loris-product-campaigns', product: product, block: block %}
            {%- when 'loris_fomo' -%}
              {% render 'loris-product-fomo', product: product, block: block %}
            {%- when 'custom_option' -%}
              {% render 'pdp-block-custom-option', block: block, product: product %}
            {%- when 'fragrance_family' -%}
              {% render 'product-fragrance-family', product: product, block: block %}
            {%- when 'description' -%}
              {% render 'pdp-block-description', block: block, product: product %}
            {%- when 'estimated_delivery' -%}
              <script src="{{ 'estimated-delivery.js' | asset_url }}" defer="defer"></script>
              {%- render 'estimated-delivery', block: block, product: product -%}
            {%- when 'feature_icons' -%}
              {% render 'pdp-block-feature-icons', block: block, product: product %}
            {%- when 'feature_tags' -%}
              {% render 'pdp-block-feature-tags', block: block, product: product %}
            {%- when 'icon_with_text' -%}
              {% render 'pdp-block-icon-with-text', block: block %}
            {%- when 'image' -%}
              {% render 'pdp-block-image', block: block, section: section %}
            {%- when 'information_popup' -%}
              {% render 'pdp-block-information-popup', block: block, product: product %}
            {%- when 'inventory' -%}
              {% render 'pdp-block-inventory', block: block, section: section, product: product %}
            {%- when 'payments_badge' -%}
              {% render 'pdp-block-payments-badge', block: block %}
            {%- when 'pickup-availability' -%}
              {% render 'pdp-block-pickup-availability', block: block, section: section, product: product %}
            {%- when 'price' -%}
              {% render 'pdp-block-price', block: block, section: section, product: product, initial_sp_price: initial_sp_price, initial_sp_compare_at_price: initial_sp_compare_at_price %}
            {%- when 'product_variations' -%}
              {% render 'pdp-block-product-variations', block: block, section: section, product: product %}
            {%- when 'promo' -%}
              {% render 'pdp-block-promo', block: block %}
            {%- when 'rating' -%}
              {% render 'pdp-block-rating', block: block, product: product %}
            {%- when 'separator' -%}
              {% render 'pdp-block-separator', block: block %}
            {%- when 'share_buttons' -%}
              {% render 'pdp-block-share-buttons', block: block, product: product %}
            {%- when 'sku' -%}
              {% render 'pdp-block-sku', block: block, section: section, product: product %}
            {%- when 'specification' -%}
              {% render 'pdp-block-specification', block: block, product: product %}
            {%- when 'subscription_widget' -%}
              {% render 'pdp-block-subscription-widget', block: block, section: section, product: product, product_form_id: product_form_id %}
            {%- when 'text' -%}
              {% render 'pdp-block-text', block: block %}
            {%- when 'title' -%}
              {% render 'pdp-block-title', block: block, product: product, title_tag: 'h1' %}
            {%- when 'upsell' -%}
              {% render 'pdp-block-upsell', block: block, section: section, product: product %}
            {%- when 'variant_picker' -%}
              {% render 'pdp-block-variant-picker', block: block, section: section, product: product, product_form_id: product_form_id, selected_variant: selected_variant, enabled_preselect: enabled_preselect %}
            {%- when 'video_reels' -%}
              {% render 'pdp-block-video-reels', block: block, section: section %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </section>

    {% if section.settings.loris_mobile_sticky_enabled and product.available %}
      {% assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first %}
      {% if buy_block != blank %}
        {{ 'loris-sticky-cart.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'loris-sticky-cart.js' | asset_url }}" defer></script>
        {% render 'loris-sticky-cart', product: product, section: section, product_form_id: product_form_id %}
      {% endif %}
    {% elsif section.settings.enable_sticky_buy_button %}
      <sticky-buy-button class="wt-product__sticky-buy 
        {% if section.settings.sticky_button_type == 'floating' %} wt-product__floating-buy {% endif %} 
        {% if section.settings.sticky_button_visibility == 'desktop' or section.settings.sticky_button_visibility == 'both' %} wt-product__sticky-buy--desktop {% endif %}
        {% if section.settings.sticky_button_visibility == 'mobile' or section.settings.sticky_button_visibility == 'both' %} wt-product__sticky-buy--mobile {% endif %}
        {% if section.settings.sticky_shadow %} wt-product__sticky-buy--shadow {% endif %}"
      {% if product.has_only_default_variant and product.available %}
        data-add-to-cart
      {% endif %}
      >
        <div class="wt-product__sticky-buy__wrapper">
          {% if section.settings.sticky_button_show_image == 'yes' or section.settings.sticky_button_product_info != 'none' %}
          <div class="wt-product__sticky-buy__product">
            {% if product.selected_or_first_available_variant.featured_image %}
            {% assign featured_image = product.selected_or_first_available_variant.featured_image %}
            {% else %}
              {% assign featured_image = product.featured_image %}
            {% endif %}
            {% if section.settings.sticky_button_show_image == 'yes' and featured_image %}
              <img
                srcset="
                  {% if featured_image.width >= 40 %}{{ featured_image | image_url: width: 40 }} 40w, {% endif %}
                  {% if featured_image.width >= 80 %}{{ featured_image | image_url: width: 80 }} 80w, {% endif %}
                  {% if featured_image.width >= 160 %}{{ featured_image | image_url: width: 160 }} 160w, {% endif %}
                  {% if featured_image.width >= 320 %}{{ featured_image | image_url: width: 320 }} 320w, {% endif %}
                  {% if featured_image.width >= 640 %}{{ featured_image | image_url: width: 640 }} 640w, {% endif %}
                  {{ featured_image | image_url: width: 80 }} 80w
                "
                sizes="(max-width: 320px) 100vw, 240px"
                src="{{ featured_image | image_url: width: 240 }}"
                alt="{{ featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                height="{{ featured_image.height }}"
                width="{{ featured_image.width }}"
                id="sticky-image-{{ section.id }}"
              >
            {% endif %}
            {% if section.settings.sticky_button_product_info != 'none' %}
            <div class="wt-product__sticky-buy__product-info">
              {% if section.settings.sticky_button_product_info == 'title_only' or section.settings.sticky_button_product_info == 'title_and_price' %}
                <div class="card__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </div>
              {% endif %}
              {% if section.settings.sticky_button_product_info == 'price_only' or section.settings.sticky_button_product_info == 'title_and_price' %}
              <div id="sticky-price-{{ section.id }}">
                {%- render 'price',
                  product: product,
                  use_variant: true,
                  show_compare_at_price: true,
                  price_class: ''
                -%}
                </div>
              {% endif %}
            </div>
          {% endif %}
          </div>
          {% endif %}
          <button
            aria-label="{{ 'products.product.add_to_cart' | t }}"
            class="js-add-to-cart wt-product__sticky-buy__button wt-button wt-button--full-width wt-button--primary {% if section.settings.sticky_button_select == 'secondary' %} wt-button--secondary {% endif %}
            {% if section.settings.sticky_button_show_image == 'no' and section.settings.sticky_button_product_info == 'none' %} wt-button--center {% endif %}"
            {% if product.has_only_default_variant and product.available %}
              type="submit"
              form="{{product_form_id}}"
            {% endif %}
          >
            {% if settings['enable-bag-icon'] %}
              {% render 'icons', id: 'bag' %}
            {% endif %}

            <span>
            {% if product.has_only_default_variant and product.available %}
                {{ 'products.product.add_to_cart' | t }}
              {% elsif product.available == false %}
                {{ 'products.product.sold_out' | t }}
              {% elsif product.options.size == 1 %}
                {{ 'products.product.choose_option' | t }}
              {% else %}
                {{ 'products.product.choose_options' | t }}
              {% endif%}
            </span>
            {% render 'button-loading-indicator' %}
          </button>
        </div>
      </sticky-buy-button>
    {% endif %}
  </div>
</section>

{% if collapsible_drawer_exist %}
   <script src="{{ 'drawer-content.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% if section.settings['desktop-layout'] == fashion_type %}
  </gallery-fashion>
{% endif %}

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

{% render 'structured-data-product', product: product %}

<script type="module" src="{{ 'gallery.js' | asset_url }}" defer="defer"></script>
<script type="module" src="{{ 'pdp.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "loris_mobile_sticky_enabled",
      "label": "Loris mobil sabit sepet",
      "info": "Canlı temadaki küçültülebilir mobil sepet tasarımı.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.main-product.settings.sticky_buy_button.header"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_buy_button",
      "label": "t:sections.main-product.settings.sticky_buy_button.enable.label",
      "default": true
    },
    {
      "type": "select",
      "id": "sticky_button_visibility",
      "label": "t:sections.main-product.settings.sticky_buy_button.visibility.label",
      "options": [
