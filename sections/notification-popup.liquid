<script src="{{ 'notification-popup.js' | asset_url }}" defer="defer"></script>
{% assign has_discount_code_block = false %}
{%- assign visible_block_count = section.blocks.size -%}
{%- assign image_only = false -%}
{%- if visible_block_count == 0 -%}
  {%- assign image_only = true -%}
{%- endif -%}

{%- comment -%} Görsel oranları (genişlik / yükseklik) {%- endcomment -%}
{%- assign ratio_desktop = 1 -%}
{%- if section.settings.desktop_image != blank -%}
  {%- assign ratio_desktop = section.settings.desktop_image.aspect_ratio -%}
{%- elsif section.settings.mobile_image != blank -%}
  {%- assign ratio_desktop = section.settings.mobile_image.aspect_ratio -%}
{%- endif -%}
{%- assign ratio_mobile = ratio_desktop -%}
{%- if section.settings.mobile_image != blank -%}
  {%- assign ratio_mobile = section.settings.mobile_image.aspect_ratio -%}
{%- endif -%}

{% for block in section.blocks %}
  {% if block.type == 'discount_code' %}
    {% assign has_discount_code_block = true %}
  {% endif %}
{% endfor %}
{% if has_discount_code_block %}
  {{ 'block-countdown-with-discount.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'countdown-discount.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% assign background_rgb = section.settings.background_color | color_to_rgb %}
{% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

<style>
    [data-section-id="{{ section.id }}"]
    {
      {% if section.settings.background_color != blank and section.settings.background_color != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-background: {{ section.settings.background_color }};
        {% endif %}

        {% if section.settings['color-body-text'] != blank and section.settings['color-body-text'] != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
            --color-custom-text: {{ section.settings.color-body-text }};
        {% endif %}

        {% if section.settings.margin-top %}
            --section-gap-top: {{ section.settings.margin-top }}px;
        {% endif %}

        {% if section.settings.margin-bottom %}
            --section-gap-bottom: {{ section.settings.margin-bottom }}px;
        {% endif %}
    }

  {%- for block in section.blocks -%}
    [data-block-id="{{ block.id }}"]
    {
          --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};
          --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};
    }
  {%- endfor -%}

  hr{
    color: var(--color-border);
  }

  /* --- Görsel otomatik boyut (her durumda) --- */
  [data-section-id="{{ section.id }}"] .newsletter__image,
  [data-section-id="{{ section.id }}"] .newsletter__image picture {
    height: auto !important;
    padding: 0 !important;
    aspect-ratio: auto !important;
  }
  [data-section-id="{{ section.id }}"] .newsletter__image img {
    width: 100% !important;
    height: auto !important;
    object-fit: contain !important;
  }

  /* --- Sadece görsel modu --- */
  [data-section-id="{{ section.id }}"].newsletter--image-only {
    background: transparent !important;
    padding: 0 !important;
  }
  [data-section-id="{{ section.id }}"].newsletter--image-only .newsletter__container {
    position: relative;
    padding: 0 !important;
    background: transparent !important;
    overflow: hidden;
  }
  [data-section-id="{{ section.id }}"].newsletter--image-only .newsletter__wrapper--popup {
    position: absolute !important;
    top: 10px;
    right: 10px;
    width: auto !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
    z-index: 5;
  }
  [data-section-id="{{ section.id }}"].newsletter--image-only .newsletter__content {
    display: none !important;
  }
  [data-section-id="{{ section.id }}"].newsletter--image-only .newsletter__nav {
    position: static;
    padding: 0;
    margin: 0;
  }
  [data-section-id="{{ section.id }}"].newsletter--image-only .newsletter__close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    transition: background .2s;
  }
  [data-section-id="{{ section.id }}"].newsletter--image-only .newsletter__close-btn:hover {
    background: #fff;
  }
  [data-section-id="{{ section.id }}"].newsletter--image-only .newsletter__close-btn svg {
    width: 16px;
    height: 16px;
  }

  #shopify-section-{{ section.id }}{
        {% if image_only %}
          --max-width: min({{ section.settings.max_width }}px, calc(85vh * {{ ratio_desktop }}));
        {% else %}
          --max-width: {{ section.settings.max_width }}px;
        {% endif %}

        {% case section.settings.desktop_vertical_position %}
            {% when 'top' %}
                --top: 32px;
            {% when 'center' %}
                --top: 50%;
                --translateY : -50%;
            {% when 'bottom' %}
                --bottom: 32px;
        {% endcase %}

        {% case section.settings.desktop_horizontal_position %}
            {% when 'left' %}
                --left: 32px;
            {% when 'center' %}
                --left: 50%;
                --translateX: -50%;
            {% when 'right' %}
                --right: 32px;
        {% endcase %}
    }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {% if image_only %}
        --max-width: min({{ section.settings.max_width }}px, 92vw, calc(85vh * {{ ratio_mobile }}));
      {% else %}
        --max-width: min({{ section.settings.max_width }}px, 92vw);
      {% endif %}
    }
  }
</style>

{% assign has_subscription = false %}
{% if customer.tags contains 'newsletter' %}
  {% assign has_subscription = true %}
{% endif %}

<div
  data-section-id="{{ section.id }}"
  class="
    newsletter newsletter--popup
    newsletter--ver-{{ section.settings.desktop_vertical_position }}
    newsletter--hor-{{ section.settings.desktop_horizontal_position }}
    {% if section.settings.show_shadow %} newsletter--shadow{% endif %}
    {% if section.settings.show_border %} newsletter--border{% endif %}
    {% if image_only %} newsletter--image-only{% endif %}
  "
>
  <div class="newsletter__container">
    {% if section.settings.desktop_image or section.settings.mobile_image %}
      <div class="newsletter__image">
        {% render 'picture',
          desktop_image: section.settings.desktop_image,
          mobile_image: section.settings.mobile_image,
          loading_option: 'eager'
        %}
      </div>
    {% endif %}

    <div class="newsletter__wrapper--popup">
      <notification-popup data-has-subscription="{{ has_subscription }}" data-delay="{{ section.settings.delay }}">
        <nav class="newsletter__nav">
          <a class="newsletter__close-btn" href="#" aria-label="{{ 'newsletter.close' | t }}">
            {% render 'icons', id: 'close' %}
          </a>
        </nav>
      </notification-popup>

      <div class="newsletter__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'custom_liquid' -%}
              {{ block.settings.custom_liquid }}
            {%- when 'heading' -%}
              <h2
                data-block-id="{{ block.id }}"
                class="{% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} hero__title {% if block.settings.heading_disable_on_mobile == true %} hero__title--mobile{% endif %}"
              >
                {% render 'headline', title: block.settings.heading %}
              </h2>
            {%- when 'paragraph' -%}
              <div class="{% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} hero__text newsletter__text{% if block.settings.text_disable_on_mobile == true %} hero__text--mobile{% endif %} rte">
                {{ block.settings.paragraph }}
              </div>
            {%- when 'image' -%}
              {% if block.settings.image != blank %}
                <div
                  class="wt-notification-popup__image wt-notification-popup__image--{{ block.settings.image_alignment }}"
                  style="--popup-image-height: {{ block.settings.image_height }}px"
                >
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag: loading: 'lazy'
                  }}
                </div>
              {% endif %}
            {%- when 'discount_code' -%}
              {% if block.settings.discount_code != blank %}
                <div class="wt-notification-popup__discount-code">
                  <div class="wt-countdown-discount__code">
                    {{ block.settings.discount_code }}
                    <countdown-discount>
                      <button
                        class="wt-countdown-discount__copy-btn"
                        type="button"
                        data-copy="{{ block.settings.discount_code | escape }}"
                        aria-label="{{ 'general.copy' | t }}"
                        data-label-copied="{{ 'general.copied' | t }}"
                      >
                        {%- render 'icon-copy' -%}
                        <span>{{- 'general.copy' | t -}}</span>
                      </button>
                    </countdown-discount>
                  </div>
                </div>
              {% endif %}
            {%- when 'email_form' -%}
              {% form 'customer', class: 'newsletter-form' %}
                <input type="hidden" name="contact[email]" value="newsletter">

                <div class="{% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} wt-newsletter__fieldset {% if form.posted_successfully? %} hidden {% endif %}">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="wt-newsletter__field"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >

                  <button
                    aria-label="{% if block.settings.button_label != blank %}{{ block.settings.button_label }}{% else %}{{'newsletter.button_label' | t }}{% endif %}"
                    type="submit"
                    class="wt-newsletter__send wt-newsletter__send--{{ block.settings.button_select }}"
                    name="commit"
                  >
                    <span class="wt-newsletter__send__text">
                      {% if block.settings.button_label != blank %}{{ block.settings.button_label }}{% else %}{{'newsletter.button_label' | t }}{% endif %}
                    </span>
                  </button>
                </div>
                {%- if form.errors -%}
                  <div class="form__message">
                    <div class="form__error-field">
                      {% for error in form.errors %}
                        <p id="Newsletter-error--{{ section.id }}">
                          {% if error == 'form' %}
                            {{ form.errors.messages[error] }}
                          {% else %}
                            {{ form.errors.translated_fields[error] }} - {{ form.errors.messages[error] }}
                          {% endif %}
                        </p>
                      {% endfor %}
                    </div>
                  </div>
                {%- endif -%}

                {%- if form.posted_successfully? -%}
                  <div class="form__message">
                    <div class="form__success-field" tabindex="-1" autofocus>
                      <p>{{- 'newsletter.success' | t }}</p>
                    </div>
                  </div>
                {%- endif -%}
              {% endform %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.notification_popup.name",
  "tag": "section",
  "class": "spaced-section spaced-section--full-width not-pu-section hidden",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.notification_popup.settings.important-information.content",
      "info": "t:sections.notification_popup.settings.important-information.info"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:sections.notification_popup.settings.max_width.label",
      "min": 300,
      "max": 800,
      "step": 10,
      "default": 450,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "delay",
      "label": "t:sections.notification_popup.settings.delay.label",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 0,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "t:sections.notification_popup.settings.show_border.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "t:sections.header.settings.show_shadow.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.global.mobile_version"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.settings.settings.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.desktop_version"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:sections.settings.settings.image.label"
    },
    {
      "type": "select",
      "id": "desktop_vertical_position",
      "options": [
        { "value": "top", "label": "t:sections.image-banner.settings.desktop_text_vertical_position.top.label" },
        { "value": "center", "label": "t:sections.image-banner.settings.desktop_text_vertical_position.center.label" },
        { "value": "bottom", "label": "t:sections.image-banner.settings.desktop_text_vertical_position.bottom.label" }
      ],
      "default": "center",
      "label": "t:sections.notification_popup.settings.desktop_vertical_position.label"
    },
    {
      "type": "select",
      "id": "desktop_horizontal_position",
      "options": [
        { "value": "left", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.left.label" },
        { "value": "center", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.center.label" },
        { "value": "right", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.right.label" }
      ],
      "default": "center",
      "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "color-body-text",
      "label": "t:sections.settings.settings.text-color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.settings.settings.background-color.label"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "image",
      "name": "t:sections.notification_popup.blocks.image.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.notification_popup.blocks.image.settings.image.label"
        },
        {
          "type": "range",
          "id": "image_height",
          "label": "t:sections.notification_popup.blocks.image.settings.image_height.label",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 60,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "image_alignment",
          "label": "t:sections.notification_popup.blocks.image.settings.image_alignment.label",
          "options": [
            { "value": "left", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.left.label" },
            { "value": "center", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.center.label" },
            { "value": "right", "label": "t:sections.image-banner.settings.desktop_text_horizontal_position.right.label" }
          ],
          "default": "center"
        }
      ]
    },
    {
      "type": "discount_code",
      "name": "t:sections.notification_popup.blocks.discount_code.name",
      "settings": [
        {
          "type": "text",
          "id": "discount_code",
          "label": "t:blocks.countdown_discount.settings.discount_code.label",
          "default": "SAVE20"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.custom-liquid.settings.custom_liquid.label",
          "info": "t:sections.custom-liquid.settings.custom_liquid.info"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.newsletter.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "heading",
          "default": "Subscribe to our emails",
          "label": "t:sections.settings.settings.heading.label"
        },
        {
          "type": "checkbox",
          "id": "heading_disable_on_mobile",
          "label": "t:sections.global.heading_disable_on_mobile",
          "default": false
        },
        {
          "type": "range",
          "id": "size_heading",
          "min": 50,
          "max": 500,
          "step": 10,
          "default": 100,
          "label": "t:sections.settings.settings.size-heading.label",
          "unit": "%"
        },
        {
          "type": "range",
          "id": "size_heading_mobile",
          "min": 80,
          "max": 300,
          "step": 10,
          "default": 100,
          "label": "t:sections.settings.settings.size-heading-mobile.label",
          "unit": "%"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "paragraph",
          "default": "<p>Be the first to know about new collections and exclusive offers.</p>",
          "label": "t:sections.settings.settings.text.label"
        },
        {
          "type": "checkbox",
          "id": "text_disable_on_mobile",
          "label": "t:sections.global.disable_on_mobile",
          "default": false
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "button_select",
          "options": [
            { "value": "primary", "label": "t:sections.settings.settings.button_select.primary.label" },
            { "value": "secondary", "label": "t:sections.settings.settings.button_select.secondary.label" }
          ],
          "default": "primary",
          "label": "t:sections.settings.settings.button_select.default.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.image-with-text.button.settings.button_label.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.notification_popup.name",
      "blocks": [
        { "type": "heading" },
        { "type": "paragraph" },
        { "type": "email_form" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}