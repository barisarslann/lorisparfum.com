<script src="{{ 'page-header-image-video.js' | asset_url }}" defer="defer"></script>

{% if template == 'index' %}
  {{ 'section-video.css' | asset_url | stylesheet_tag }}

  {% assign background_rgb = section.settings['color-overlay'] | color_to_rgb %}
  {% assign text_rgb = section.settings['color-body-text'] | color_to_rgb %}

  <style>
    [data-section-id="{{ section.id }}"] .wt__video {
    {% if section.settings['color-body-text'] != blank and section.settings['color-body-text'] != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.color-body-text }};
    {% endif %}
    }

    [data-section-id="{{ section.id }}"] {

        --border-radius: 0;

    {% if section.settings.slide_height == 'fixed_height' %}
        --section-height: {{ section.settings.mobile_fixed_height }}px;
        --section-height-desk: {{ section.settings.desktop_fixed_height }}px;
    {% endif %}

    {% if section.settings.slide_height == 'adapt_to_first_image' %}
        --first-slide-ratio: {{ section.blocks.first.settings.mobile_image.aspect_ratio | default: 1 }};
        --first-slide-ratio-desk: {{ section.blocks.first.settings.desktop_image.aspect_ratio | default: 2.5 }};
    {% endif %}

    }

    [data-section-id="{{ section.id }}"] .hero__overlay {

    {% if section.settings['color-body-text'] != blank and section.settings['color-body-text'] != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.color-body-text }};
    {% endif %}

    {% if section.settings['color-overlay'] != blank and section.settings['color-overlay'] != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-overlay-rgb: {{ section.settings.color-overlay | color_to_rgb | remove: 'rgb(' | remove: ')' }};
        --color-overlay-opacity: {{ section.settings.color-overlay-opacity | divided_by: 100.0 }};
    {% else %}
        --text-container-opacity: 0;
    {% endif %}
    }

    {%- for block in section.blocks -%}
    [data-block-id="{{ block.id }}"] {
        --font-headline-scale-desk: {{ block.settings.size_heading | divided_by: 100.0 }};

        --font-headline-scale: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};

        {% if block.type == 'heading' and block.settings.advanced_heading %}
          {% assign body_text_rgb = section.settings['color-body-text'] | color_to_rgb %}
          {% assign heading_color = section.settings['color-body-text'] %}
          {% if section.settings['color-body-text'] == blank or section.settings['color-body-text'] == 'transparent' or body_text_rgb == 'rgba(0, 0, 0, 0.0)' %}
            {% assign heading_color = settings['color-headings-text'] %}
          {% endif %}
          {% if block.settings.heading_underline_style == blank or block.settings.heading_underline_style == 'none' %}
            {% if block.settings.heading_richtext_color != blank %}
              {% assign heading_color = block.settings.heading_richtext_color %}
            {% endif %}
            {% if block.settings.heading_richtext_gradient != blank %}
              {% assign heading_color = block.settings.heading_richtext_gradient %}
            {% endif %}
          {% endif %}
          --color-custom-heading: {{ heading_color }};
        {% endif %}

        {% if block.type == 'icon_with_text' %}
          --icon-height-desktop: {{ block.settings.icon_height_desktop }}px;
          --icon-height: {{ block.settings.icon_height }}px;
          --icon-margin-desktop: {{ block.settings.icon_margin_desktop }}px;
          --icon-margin: {{ block.settings.icon_margin }}px;
          --size-heading-desktop: {{ block.settings.size_heading | divided_by: 100.0 }};
          --size-heading: {{ block.settings.size_heading_mobile | divided_by: 100.0 }};
          --gap: {{ block.settings.gap }}px;
          --margin-top: {{ block.settings.margin_top }}px;
          --margin-bottom: {{ block.settings.margin_bottom }}px;
          --margin-left: {{ block.settings.margin_left }}px;
          --margin-left-desktop: {{ block.settings.margin_left_desktop }}px;
          {% if block.settings.icon_alignment != 'inherit' %}
            --icon-alignment: {{ block.settings.icon_alignment }};
          {% endif %}
          {% if block.settings.icon_alignment_mobile != 'inherit' %}
            --icon-alignment-mobile: {{ block.settings.icon_alignment_mobile }};
          {% endif %}

          {% if block.settings.icon_alignment == "flex-start" %}
            --icon-text-alignment: left;
          {% elsif block.settings.icon_alignment == "flex-end" %}
            --icon-text-alignment: right;
          {% elsif block.settings.icon_alignment == "center" %}
            --icon-text-alignment: center;
          {% endif %}

          {% if block.settings.icon_alignment_mobile == "flex-start" %}
            --icon-text-alignment-mobile: left;
          {% elsif block.settings.icon_alignment_mobile == "flex-end" %}
            --icon-text-alignment-mobile: right;
          {% elsif block.settings.icon_alignment_mobile == "center" %}
            --icon-text-alignment-mobile: center;
          {% endif %}
        {% endif %}

        {% if block.type == 'text' and block.settings.text_style == 'subtitle' %}
            --font-base: var(--font-headline);
        {% endif %}

        {% if block.type == 'subheading' and block.settings.subheading_advanced_settings %}
          --font-subheading-scale: {{ block.settings.size_text_mobile | divided_by: 100.0 }};
          --font-subheading-scale-desk: {{ block.settings.size_text_desktop | divided_by: 100.0 }};
          --subheading-letter-spacing: {{ block.settings.letter_spacing }}px;
          {% if block.settings.text_uppercase %}
            --subheading-text-transform: uppercase;
          {% endif %}
          {% if block.settings.text_style == 'body' %}
            --subheading-font-family: var(--font-base);
          {% endif %}
        {% endif %}
    }
    {%- endfor -%}
  </style>

  {% assign width_line = 'wt-section__wrapper wt-section__wrapper--full' %}

  {%- liquid
    assign video_id = section.settings.video.id | default: section.settings.video_url.id
  -%}

  <script src="{{ 'low-power-video.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'video-controls.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'heading-animations.js' | asset_url }}" defer="defer"></script>

  <page-header-image-video
    class="{{ width_line }}"
    data-section-id="{{ section.id }}"
    data-content-position="{{ section.settings.content_position }}"
  >
    {% if section.settings.layout == 'video_first' %}
      {% assign class_name = 'wt-video--rev' %}
    {% else %}
      {% assign class_name = '' %}
    {% endif %}


    {%liquid
      assign video_controls = section.settings.video_controls
      assign video_controls_embedded = 0
      if video_controls
        assign video_controls_embedded = 1
      endif

      assign video_autoplay = section.settings.autoplay
      assign video_autoplay_embedded = 0
      if video_autoplay
        assign video_autoplay_embedded = 1
      endif

      assign video_loop = section.settings.video_loop
      assign video_loop_embedded = 0
      if video_loop
       assign video_loop_embedded = 1
     endif

      assign video_muted = false
      assign video_muted_embedded = 0

      assign custom_controls = false
      if section.settings.video_custom_play_controls or section.settings.video_custom_mute_controls
        assign custom_controls = true
      endif


      if section.settings.autoplay
        assign video_muted = true
        assign video_muted_embedded = 1
      endif
    %}


      <div
        class="{% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %} wt-video {{ class_name }}"
        data-mobile="{{ section.settings.layout_mobile }}"
        data-height="{{ section.settings.slide_height }}"
      >
        {% render 'hero',
          type: 'blocks',
          classname: 'wt-video__item wt-video__item--hero',
          desktop_text_horizontal_position: section.settings.desktop_text_horizontal_position,
          desktop_text_vertical_position: section.settings.desktop_text_vertical_position,
          mobile_text_horizontal_position: section.settings.mobile_text_horizontal_position,
          mobile_text_vertical_position: section.settings.mobile_text_vertical_position,
          desktop_image: section.settings.desktop_image,
          mobile_image: section.settings.mobile_image,
          placeholder: 'collection-apparel-1',
          blocks: section.blocks,
          href_only_on_button: false,
          loading_option: 'eager',
          lcp_tweak: true
        %}

        <div class="wt-video__movie wt-video__movie--shopify-video wt-video__item">
          {% render 'hero',
            type: 'blocks',
            classname: 'wt-video__item wt-video__item--over-video',
            desktop_text_horizontal_position: section.settings.desktop_text_horizontal_position,
            desktop_text_vertical_position: section.settings.desktop_text_vertical_position,
            mobile_text_horizontal_position: section.settings.mobile_text_horizontal_position,
            mobile_text_vertical_position: section.settings.mobile_text_vertical_position,
            placeholder: 'collection-apparel-1',
            blocks: section.blocks,
            href_only_on_button: false,
            hide_image: true
          %}

          <div class="wt-video__movie__video-hosted-wrapper">
            {% if section.settings.video_hosted %}
              <div class="wt-video-hosted wt-video-hosted--desktop">
                <low-power-video>
                  {% if custom_controls %}
                    <video-controls>
                    {% if section.settings.video_custom_play_controls %}
                      {% render 'play-pause-button', classname: mobile_video_class %}
                    {% endif %}

                    {% if section.settings.video_custom_mute_controls %}
                      {%liquid
                        assign sound_state = 'off'
                        if video_muted != true
                          assign sound_state = 'on'
                        endif
                      %}
                      {% render 'unmute-button', initial_state: sound_state %}
                    {% endif %}
                  {% endif %}

                    {{
                      section.settings.video_hosted
                      | video_tag: autoplay: video_autoplay, loop: video_loop, muted: video_muted, controls: video_controls, image_size: '600x'
                    }}

                  {% if custom_controls %}
                    </video-controls>
                  {% endif %}
                </low-power-video>
              </div>

            {% else %}

              <div class="wt-video-hosted wt-video-hosted--desktop wt-video-hosted--placeholder">
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'hero__img hero__img--placeholder' }}
              </div>

            {% endif %}            

            {% if section.settings.video_hosted_mobile %}
              <div class="wt-video-hosted wt-video-hosted--mobile">
                <low-power-video>
                  {% if custom_controls %}
                    <video-controls>
                    {% if section.settings.video_custom_play_controls %}
                      {% render 'play-pause-button', classname: mobile_video_class %}
                    {% endif %}

                    {% if section.settings.video_custom_mute_controls %}
                      {%liquid
                        assign sound_state = 'off'
                        if video_muted != true
                          assign sound_state = 'on'
                        endif
                      %}
                      {% render 'unmute-button', initial_state: sound_state %}
                    {% endif %}
                  {% endif %}

                  {{
                    section.settings.video_hosted_mobile
                    | video_tag: autoplay: video_autoplay, loop: video_loop, muted: video_muted, controls: video_controls, image_size: '600x'
                  }}

                  {% if custom_controls %}
                    </video-controls>
                  {% endif %}
                </low-power-video>
              </div>
            {% else %}

              <div class="wt-video-hosted wt-video-hosted--mobile wt-video-hosted--placeholder">
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'hero__img--placeholder' }}
              </div>

            {% endif %}
          </div>
        </div>
      </div>
  </page-header-image-video>

  <script>
    (() => {
      const currentSection = document.querySelector('.wt-video__section--header');

      function isValidSectionsOrder() {
        const pageHeader = document.body.querySelector('header.page-header');

        if (pageHeader && currentSection) {
          let sibling = pageHeader.nextElementSibling;
          while (sibling && sibling.tagName.toLowerCase() !== 'section') {
            sibling = sibling.nextElementSibling;
          }
          return sibling === currentSection;
        }
        return false;
      }

      function isTransparentHeaderEnabled() {
        const header = document.querySelector('.wt-header');
        return isValidSectionsOrder() && Boolean(header?.dataset.transparent);
      }

      function calculateOffset() {
        const header = document.querySelector('header');
        const headerHeight = header.offsetHeight;

        const announcement = document.querySelector('.wt-announcement');
        const announcementHeight = announcement ? announcement.offsetHeight : 0;
        const offset = isTransparentHeaderEnabled() ? headerHeight + announcementHeight : 0;

        return offset;
      }

      function setTopMargin() {
        const offset = calculateOffset();
        currentSection.style.marginTop = `-${offset}px`;
      }

      if (isTransparentHeaderEnabled()) {
        setTopMargin();
      }
    })();
  </script>
{% endif %}

