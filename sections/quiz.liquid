<script src="{{ 'quiz.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign show_section = false
  if request.design_mode == true or section.blocks.size > 0
    assign show_section = true
  endif

-%}

{% if show_section %}
  {% assign background_rgb = section.settings.background_color | color_to_rgb %}
  {% assign text_rgb = section.settings.text_color | color_to_rgb %}

  <style>
    [data-section-id="{{ section.id }}"] {
      {% if section.settings.margin-top %}
        --section-gap-top: {{ section.settings.margin-top }}px;
      {% endif %}
      {% if section.settings.margin-bottom %}
        --section-gap-bottom: {{ section.settings.margin-bottom }}px;
      {% endif %}
      {%- if section.settings.show_mobile_spacing -%}
        --section-gap-top-mobile: {{ section.settings.margin-top-mobile }}px;
        --section-gap-bottom-mobile: {{ section.settings.margin-bottom-mobile }}px;
      {%- endif -%}
      {% if section.settings.text_color != blank and section.settings.text_color != 'transparent' and text_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-custom-text: {{ section.settings.text_color }};
        --color-custom-text-rgb: {{ text_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' }};
      {% endif %}
      {% if section.settings.background_color != blank and section.settings.background_color != 'transparent' and background_rgb != 'rgba(0, 0, 0, 0.0)' %}
        --color-background: {{ section.settings.background_color }};
      {% endif %}
      --quiz-body-text-rgb: {{ settings['color-body-text'] | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' }};
    }
  </style>

  <quiz-section
    class="wt-quiz"
    data-section-id="{{ section.id }}"
  >

    {%- if section.settings.heading != blank -%}
       <div class="headline headline--rich {% if settings.animations %} scroll-trigger animate--slide-in {% endif %} {% if settings.disabled_animations_on_mobile %} disabled-on-mobile {% endif %}">
          {{ section.settings.heading }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_progress_bar -%}
      <div class="wt-quiz__header">
        <div class="wt-quiz__progress" hidden>
          <div class="wt-quiz__progress-bar">
            <div class="wt-quiz__progress-fill"></div>
          </div>
          <span class="wt-quiz__progress-text"></span>
        </div>
      </div>
    {%- endif -%}

    <div class="wt-quiz__slides">
      {%- for block in section.blocks -%}
          <quiz-slide
            class="wt-quiz__slide{% if forloop.first %} is-active{% endif %}"
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {%- render block -%}
          </quiz-slide>
      {%- endfor -%}
    </div>
  </quiz-section>
{% endif %}

{% schema %}
{
  "name": "t:sections.quiz.name",
  "tag": "section",
  "class": "wt-shopify-section",
  "settings": [
     {
       "type": "paragraph",
       "content": "t:sections.quiz.settings.support_info.content"
     },
     {
      "type": "richtext",
      "id": "heading",
      "label": "t:sections.settings.settings.heading.label",
      "default": "<h2>Quiz</h2>"
    },
    {
      "type": "header",
      "content": "t:sections.global.colors",
      "info": "t:sections.global.colors-info"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.settings.settings.text-color.label",
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.settings.settings.background-color.label",
    },
    {
      "type": "header",
      "content": "t:sections.quiz.settings.progress_bar.content"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "t:sections.quiz.settings.show_progress_bar.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.quiz.settings.navigation.content"
    },
    {
      "type": "select",
      "id": "btn_next",
      "label": "t:sections.quiz.settings.btn_next.label",
      "options": [
        {"value": "primary", "label": "t:sections.settings.settings.button_select.primary.label"},
        {"value": "secondary", "label": "t:sections.settings.settings.button_select.secondary.label"},
        {"value": "link", "label": "t:sections.settings.settings.button_select.link.label"}
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "btn_prev",
      "label": "t:sections.quiz.settings.btn_prev.label",
      "options": [
        {"value": "primary", "label": "t:sections.settings.settings.button_select.primary.label"},
        {"value": "secondary", "label": "t:sections.settings.settings.button_select.secondary.label"},
        {"value": "link", "label": "t:sections.settings.settings.button_select.link.label"}
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "t:sections.global.section_spacing"
    },
    {
      "type": "range",
      "id": "margin-top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 0,
      "label": "t:sections.settings.settings.distance-top.label"
    },
    {
      "type": "range",
      "id": "margin-bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 4,
      "default": 0,
      "label": "t:sections.settings.settings.distance-bottom.label"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_spacing",
      "label": "t:sections.settings.settings.show-mobile-spacing.label"
    },
    {
      "type": "range",
      "id": "margin-top-mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-top-mobile.label",
      "visible_if": "{{ section.settings.show_mobile_spacing }}"
    },
    {
      "type": "range",
      "id": "margin-bottom-mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px",
      "label": "t:sections.settings.settings.distance-bottom-mobile.label",
      "visible_if": "{{ section.settings.show_mobile_spacing }}"
    }
  ],
  "blocks": [
    {"type": "intro"},
    {"type": "question"},
    {"type": "newsletter"},
    {"type": "results"}
  ],
  "presets": [
    {
      "name": "t:sections.quiz.name",
      "category": "t:sections.categories.storytelling",
      "blocks": [
        {
          "type": "intro"
        },
        {
          "type": "question"
        },
        {
          "type": "results"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
