{%- comment -%}
  card-pro-variation-swatches.liquid — product siblings swatches for card-pro.
  Renders swatch dots + data-attributes; sibling data fetched on click by card-product-siblings.js.
{%- endcomment -%}
{% if product_variations.count > 0 %}
  <div
    class="
      card__color-swatcher--container
      {% if text_alignment == 'center' %} center {% endif %}
      {% if settings.swatch_method == 'variant_image' %}variant-image{% endif %}
    "
    tabindex="-1"
    data-omit-tabindex
    data-card-siblings-swatches
  >
    {% for variation in product_variations %}
      {% assign option_name = nil %}
      {% assign option_image = nil %}
      {% assign option_color = nil %}
      {% assign option_metaobject = nil %}

      {% assign option_value = variation.metafields[product_variations_color_namespace][product_variations_color_key] %}
      {% if option_value.type contains 'metaobject_reference' %}
        {% assign option_metaobject = option_value.value %}
        {% if option_value.type contains 'list.' %}
          {% assign option_metaobject = option_value.value | first %}
        {% endif %}
        {% assign option_image = option_metaobject.image %}
        {% assign option_color = option_metaobject.color %}
        {% assign option_name = option_metaobject.label %}
      {% elsif option_value.type contains 'single_line_text_field' %}
        {% assign option_name = option_value.value %}
        {% if option_value.type contains 'list.' %}
          {% assign option_name = option_value.value | first %}
        {% endif %}
      {% endif %}

      {% if option_name == nil %}
        {% if settings.product_variations_picker_type == 'product_image' %}
          {% assign option_name = variation.title %}
        {% endif %}
      {% endif %}

      <div
        class="
          color-swatcher--wrapper
          {% if variation.available == false %}unavailable{% endif %}
          {% if settings.enable_round_color_swatches %} rounded {% endif %}
          {% if variation.handle == product.handle %} active{% endif %}
        "
        data-sibling-url="{{ variation.url }}"
        data-sibling-handle="{{ variation.handle }}"
        data-sibling-title="{{ variation.title | escape }}"
        data-sibling-available="{{ variation.available }}"
      >
        <div
          class="
            color-swatcher
            {% if variation.available == false %}unavailable{% endif %}
            {% if settings.enable_round_color_swatches %} rounded {% endif %}
          "
          data-color="{{ option_name }}"
          data-product-handle="{{ variation.handle }}"
          style="
            {% if settings.product_variations_picker_type == 'product_image' %}
              {% assign swatch_img = variation.featured_image | default: variation.images.first %}
              {% render 'color-swatch-style', swatches_config: swatches_config, swatch_image: swatch_img %};
            {% else %}
              {% render 'color-swatch-style', swatches_config: swatches_config, swatch_image: option_image, swatch_color: option_color, value: option_name %};
            {% endif %}
          "
          tabindex="0"
          role="button"
          aria-label="{{ variation.title | escape }}"
        ></div>

        {% if option_name %}
          <span class="color-swatcher--tooltip hidden">{{ option_name }}</span>
        {% endif %}

        {% if variation.available == false %}
          <div class="unavailable-line"></div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}
