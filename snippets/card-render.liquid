{%- comment -%}
  card-render.liquid — dispatcher card/card-pro wg card_style ('pro' → galeria + siblings).
{%- endcomment -%}
{% if card_style == 'pro' %}
  {% render 'card-pro',
    card_product: card_product,
    img: img,
    img_hover: img_hover,
    image_ratio: image_ratio,
    media_aspect_ratio: media_aspect_ratio,
    title: title,
    subtitle: subtitle,
    url: url,
    uri: uri,
    product: product,
    price: price,
    price_old: price_old,
    rating: rating,
    show_review_count: show_review_count,
    hide_rating_no_reviews: hide_rating_no_reviews,
    reviews: reviews,
    text_alignment: text_alignment,
    variants: variants,
    product_options: product_options,
    options: options,
    color_swatch_class: color_swatch_class,
    placeholder_image_index: placeholder_image_index,
    default_title: default_title,
    title_tag: title_tag,
    enable_quick_add_button: enable_quick_add_button,
    quick_add_mode: quick_add_mode,
    show_video: show_video,
    enable_vendor_link: enable_vendor_link,
    show_vendor_prop: show_vendor_prop,
    collection_list: collection_list,
    eager_load: eager_load,
    are_filters_active: are_filters_active,
    promo: promo,
    save: save,
    alt: alt,
    focal: focal
  %}
{% else %}
  {% render 'card',
    card_product: card_product,
    img: img,
    img_hover: img_hover,
    image_ratio: image_ratio,
    media_aspect_ratio: media_aspect_ratio,
    title: title,
    subtitle: subtitle,
    url: url,
    uri: uri,
    product: product,
    price: price,
    price_old: price_old,
    rating: rating,
    show_review_count: show_review_count,
    hide_rating_no_reviews: hide_rating_no_reviews,
    reviews: reviews,
    text_alignment: text_alignment,
    variants: variants,
    product_options: product_options,
    options: options,
    color_swatch_class: color_swatch_class,
    placeholder_image_index: placeholder_image_index,
    default_title: default_title,
    title_tag: title_tag,
    enable_quick_add_button: enable_quick_add_button,
    quick_add_mode: quick_add_mode,
    show_video: show_video,
    enable_vendor_link: enable_vendor_link,
    show_vendor_prop: show_vendor_prop,
    collection_list: collection_list,
    eager_load: eager_load,
    are_filters_active: are_filters_active,
    promo: promo,
    save: save,
    alt: alt,
    focal: focal
  %}
{% endif %}
