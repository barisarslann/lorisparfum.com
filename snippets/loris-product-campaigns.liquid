{%- comment -%}Use collection IDs for membership; translated titles are only display text.{%- endcomment -%}
{%- assign product_collection_ids = product.collections | map: 'id' -%}
{%- capture campaign_links -%}
  {%- for campaign in block.settings.campaign_collections -%}
    {%- if product_collection_ids contains campaign.id -%}
      <li style="border:1px solid #000;padding:2px 6px;border-radius:5px;margin:0;">
        <a href="{{ campaign.url }}" style="text-decoration:none;font-size:15px;">{{ campaign.title | escape }}</a>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if campaign_links != blank -%}
  <div class="relatedCats" {{ block.shopify_attributes }}>
    <div class="product-special-collections" style="display:flex;flex-wrap:wrap;line-height:1;margin-top:15px;gap:10px;row-gap:0;align-items:center;">
      <strong style="display:flex;align-items:center;gap:5px;font-size:15px;font-weight:500;">{{ 'loris_product.campaigns.heading' | t }}</strong>
      <ul style="list-style:none;margin:0;padding-inline-start:0;display:flex;gap:10px;flex-wrap:wrap;">{{ campaign_links }}</ul>
    </div>
  </div>
{%- endif -%}
