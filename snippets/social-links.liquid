<ul class="social-links">
  {% if settings.social_facebook_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_facebook_link }}"
        class="social-link"
        aria-label="Facebook"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-fb' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_twitter_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_twitter_link }}"
        class="social-link"
        aria-label="Twitter"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-twitter' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_instagram_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_instagram_link }}"
        class="social-link"
        aria-label="Instagram"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-inst' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_pinterest_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_pinterest_link }}"
        class="social-link"
        aria-label="Pinterest"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-pint' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_tiktok_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_tiktok_link }}"
        class="social-link"
        aria-label="TikTok"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-tiktok' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_tumblr_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_tumblr_link }}"
        class="social-link"
        aria-label="Tumblr"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-tumblr' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_snapchat_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_snapchat_link }}"
        class="social-link"
        aria-label="Snapchat"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-snapchat' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_youtube_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_youtube_link }}"
        class="social-link"
        aria-label="Youtube"
        target="_blank"
        rel="nofollow"
      >
        {% render 'icons', id: 'soc-youtube' %}
      </a>
    </li>
  {% endif %}

  {% if settings.social_vimeo_link != empty %}
    <li class="social-links__item">
      <a href="{{ settings.social_vimeo_link }}" class="social-link" aria-label="Vimeo" target="_blank" rel="nofollow">
        {% render 'icons', id: 'soc-vimeo' %}
      </a>
    </li>
  {% endif %}

  <!-- CUSTOM -->
  {% if settings.social_spotify_link != empty %}
    <li class="social-links__item">
      <a
        href="{{ settings.social_spotify_link }}"
        class="social-link"
        aria-label="Spotify"
        target="_blank"
        rel="nofollow"
      >
        {% comment %}{% render 'icons', id: 'soc-spotify' %}{% endcomment %}
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" class="bi bi-spotify" viewBox="0 0 16 16">
          <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.669 11.538a.5.5 0 0 1-.686.165c-1.879-1.147-4.243-1.407-7.028-.77a.499.499 0 0 1-.222-.973c3.048-.696 5.662-.397 7.77.892a.5.5 0 0 1 .166.686m.979-2.178a.624.624 0 0 1-.858.205c-2.15-1.321-5.428-1.704-7.972-.932a.625.625 0 0 1-.362-1.194c2.905-.881 6.517-.454 8.986 1.063a.624.624 0 0 1 .206.858m.084-2.268C10.154 5.56 5.9 5.419 3.438 6.166a.748.748 0 1 1-.434-1.432c2.825-.857 7.523-.692 10.492 1.07a.747.747 0 1 1-.764 1.288"></path>
        </svg>
      </a>
    </li>
  {% endif %}
</ul>
