5-aabad1eac56d/2560/k-284-yeni-frequence-web.webp\" loading=\"lazy\">\n      </a>\n    </span>\n  </div> -->\n\n</div>\n\n<a href=\"/pages/ugc\" style=\"border: 2px solid #000;padding: 15px;margin: 0 auto;display: block;width: fit-content;\">\n  Daha Fazla Gör\n</a>\n\n\n<style>\n  .videochecks {\n    position: absolute;\n    right: 0; /* 10% */\n    bottom: 25%;\n    display: grid;\n    width: 100%;\n    padding-right: 5%;\n    display: grid;\n    justify-items: flex-end;\n  }\n  .videochecks label {\n    width: 17.5%;\n    cursor: pointer;\n    border-radius: 50%;\n    overflow: hidden;\n    border: 4px solid #CEFF36;\n\n    aspect-ratio: 1;\n  }\n  .videochecks label:not(:last-of-type) {\n    margin-bottom: 15px;\n  }\n  .videochecks label img {\n    width: 100%;\n  }\n  .videochecks input {\n    display: none;\n  }\n  .videcheck + a {\n    position: absolute;\n    margin-top: -10%;\n    width: 50%;\n    right: 0;\n    margin-right: 25%;\n    border-radius: 8%;\n    overflow: hidden;\n    z-index: 10;\n    display: none;\n  }\n  .videcheck:checked + a {\n    display: block;\n  }\n  .videochecks a span {\n    display: inline-block;\n    width: 100%;\n    padding: 5px 0;\n    font-size: 20px;\n    background-color: #E5996D;\n    color: #fff;\n  }\n  .videochecks a img {\n    width: 100%;\n  }\n  .videcheck:nth-of-type(2):checked + a span {\n    background-color: #E281A6;\n  }\n</style>\n<style>\n  .uvideos {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 30px;\n  }\n  .uvideos > div {\n    position: relative;\n    display: grid;\n    width: calc(33.33% - 20px);\n    margin-bottom: 15px;\n    text-align: center;\n  }\n  .uvideos > div > a {\n    /* pointer-events: none; */\n  }\n  .uvideos .title {\n    display: inline-block;\n    width: 100%;\n    padding: 10px 0;\n    font-size: 22px;\n    background-color: #F1F1F1;\n  }\n  .uvideos video {\n    width: 100%;\n    aspect-ratio: 1/1.8;\n  }\n  .uvideos .play {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 20%;\n    z-index: 10;\n    padding: 10px;\n    cursor: pointer;\n  }\n  .uvideos .play svg {\n    width: 100%;\n    height: auto;\n    fill: #fff;\n  }\n  .uvideos .play svg.paused {\n    display: none;\n\n  }\n  .uvideos .view {\n    display: inline-block;\n    width: 45%;\n    /* margin: 20px auto 0; */\n    padding: 5px 0;\n    font-size: 22px;\n    background-color: #CEFF36;\n    cursor: default;\n    opacity: 0;\n  }\n  @media (max-width: 767px) {\n    .uvideos {\n      padding: 0 30px;\n    }\n    .uvideos > div {\n      width: 100%;\n    }\n    .uvideos .play {\n      width: 22%;\n    }\n  }\n</style>\n\n<script>\n// window.addEventListener('locationchange', function () {\n// setTimeout(() => {\n\nfunction qS(n,c){\n  return n.querySelector(c);\n}\n\ndocument.querySelectorAll(\".uvideos .videochecks label\").forEach(node => {\nnode.parentElement.previousElementSibling.style.cursor = \"default\";\n\nnode.addEventListener(\"click\", event => {\ndocument.querySelectorAll(\".uvideos .videcheck\").forEach(node => {\nif(event.currentTarget != node.previousElementSibling){\nnode.checked = false;\n}\n});\n\nvar nodeP = node.parentElement.previousElementSibling;\nqS(nodeP,\".view\").style.cursor = \"pointer\";\nqS(nodeP,\".view\").style.opacity = 1;\nnodeP.href = node.nextElementSibling.nextElementSibling.href;\n})\n});\n\ndocument.querySelectorAll(\".uvideos > div > a\").forEach(node => {\nif(!node.dataset.foreach){\nnode.dataset.foreach = 1;\nnode.addEventListener(\"click\", event => {\nif(event.target.closest(\".play\") == qS(node,\".play\")){\nevent.preventDefault();\n\nif(\n  !qS(node,\".play\").classList.contains(\"playing\")\n){\n  qS(node,\"video\").play();\n  qS(node,\".play\").classList.add(\"playing\");\n  qS(node,\".play .start\").style.display = \"none\";\n  qS(node,\".play .paused\").style.display = \"block\";\n  qS(node,\".play\").style.opacity = 0.2;\n}else{\n  qS(node,\"video\").pause();\n  qS(node,\".play\").classList.remove(\"playing\");\n  qS(node,\".play .start\").style.display = \"block\";\n  qS(node,\".play .paused\").style.display = \"none\";\n  qS(node,\".play\").style.opacity = 1;\n}\n}\n});\n}\n});\n\n// }, 1);\n// });\n</script>"
