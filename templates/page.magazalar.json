);\n    if (markers[i].domestic != \"Almanya\") {\n      // markers[i].setVisible(false);\n    }else{\n      markers[i].setVisible(true);\n    }\n  }\n}\n\nfunction showDomestic() {\n  var checkBox = document.getElementsByName(\"yurtici\")[0];\n  var i;\n  for (i = 0; i < markers.length; i++) {\n    // if (checkBox.checked == true) {\n    // console.log(markers[i].domestic);\n    if (markers[i].domestic != \"Türkiye\") {\n      markers[i].setVisible(false);\n    }else{\n      markers[i].setVisible(true);\n    }\n  }\n}\n</script>\n\n  <div class=\"search\">\n    <input type=\"text\" placeholder=\"Arayın\" style=\"border: 1px solid #0005;width: 100%;\">\n  </div>\n\n    <span class=\"selectcountry\" style=\"display: flex;justify-content: center;gap: 15px;/* margin-bottom: 15px; */margin-top: 30px;\">\n        <span style=\"background-color: #0001;padding: 5px 15px;border-radius: 5px;font-weight: 500;cursor: pointer;\">Yurt İçi</span>\n        <span style=\"background-color: #0001;padding: 5px 15px;border-radius: 5px;font-weight: 500;cursor: pointer;\">Yurt Dışı</span>\n    </span>\n<style>\n.selectcountry span.active {\n  color: #fff;\n  background-color: #000c !important;\n}\n</style>\n<script>\n// document.addEventListener(\"DOMContentLoaded\", () => {\nsetTimeout(() => {\nselectCountryFirst(\n  document.querySelector(\".selectcountry span:first-of-type\")\n);\n}, 1);\n// });\n\ndocument.querySelector(\".selectcountry span:first-of-type\").addEventListener(\"click\", event => {\n  selectCountryFirst(event.currentTarget);\n});\n\nfunction selectCountryFirst(eventCT){\n  document.querySelectorAll(\".selectcountry span\").forEach(node => {\n    node.classList.remove(\"active\");\n  });\n  eventCT.classList.add(\"active\");\n  var filter = \"Türkiye\";\n  var shopItems = document.querySelectorAll(\".shoplist .list div:not(.singleitem):not(.selectcountry)\");\n  shopItems.forEach(function(item){\n    var text = item.textContent;\n    if(text.indexOf(filter) > -1){\n      item.style.display = \"\";\n    }\n    else {\n      item.style.display = \"none\";\n    }\n  });\n}\n\ndocument.querySelector(\".selectcountry span:last-of-type\").addEventListener(\"click\", event => {\n  document.querySelectorAll(\".selectcountry span\").forEach(node => {\n    node.classList.remove(\"active\");\n  });\n  event.currentTarget.classList.add(\"active\");\n  var filter = \"Türkiye\";\n  var shopItems = document.querySelectorAll(\".shoplist .list div:not(.singleitem):not(.selectcountry)\");\n  shopItems.forEach(function(item){\n    var text = item.textContent;\n    if(text.indexOf(filter) == -1){\n      item.style.display = \"\";\n    }\n    else {\n      item.style.display = \"none\";\n    }\n  });\n});\n</script>\n\n  <span id=\"shopclose\" class=\"shopclose\" style=\"display: none;font-size: 30px;cursor: pointer;/* margin-top: 30px; */\">\n    <svg style=\"width: 40px;\" viewbox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"></g><g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></g><g id=\"SVGRepo_iconCarrier\"> <path d=\"M9.70711 8.29289C9.31658 7.90237 8.68342 7.90237 8.29289 8.29289C7.90237 8.68342 7.90237 9.31658 8.29289 9.70711L10.5858 12L8.29289 14.2929C7.90237 14.6834 7.90237 15.3166 8.29289 15.7071C8.68342 16.0976 9.31658 16.0976 9.70711 15.7071L12 13.4142L14.2929 15.7071C14.6834 16.0976 15.3166 16.0976 15.7071 15.7071C16.0976 15.3166 16.0976 14.6834 15.7071 14.2929L13.4142 12L15.7071 9.70711C16.0976 9.31658 16.0976 8.68342 15.7071 8.29289C15.3166 7.90237 14.6834 7.90237 14.2929 8.29289L12 10.5858L9.70711 8.29289Z\" fill=\"#0F1729\"></path> <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM4 12C4 7.58172 7.58172 4 12 4C16.4183 4 20 7.58172 20 12C20 16.4183 16.4183 20 12 20C7.58172 20 4 16.4183 4 12Z\" fill=\"#0F1729\"></path> </g></svg>\n    <!-- <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"></g><g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></g><g id=\"SVGRepo_iconCarrier\"> <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M5.29289 5.29289C5.68342 4.90237 6.31658 4.90237 6.70711 5.29289L12 10.5858L17.2929 5.29289C17.6834 4.90237 18.3166 4.90237 18.7071 5.29289C19.0976 5.68342 19.0976 6.31658 18.7071 6.70711L13.4142 12L18.7071 17.2929C19.0976 17.6834 19.0976 18.3166 18.7071 18.7071C18.3166 19.0976 17.6834 19.0976 17.2929 18.7071L12 13.4142L6.70711 18.7071C6.31658 19.0976 5.68342 19.0976 5.29289 18.7071C4.90237 18.3166 4.90237 17.6834 5.29289 17.2929L10.5858 12L5.29289 6.70711C4.90237 6.31658 4.90237 5.68342 5.29289 5.29289Z\" fill=\"#0F1729\"></path> </g></svg> -->\n  </span>\n  <div class=\"list\">\n    <div class=\"singleitem\"></div>\n  </div>\n</div>\n<script>\n  document.querySelector(\".shoplist .search input\").addEventListener(\"input\", function(e){\n    if(document.querySelector(\".selectcountry span.active\")){\n      document.querySelector(\".selectcountry span.active\").classList.remove(\"active\");\n    }\n    // console.log(e);\n    var filter = e.target.value.toUpperCase();\n    var shopItems = document.querySelectorAll(\".shoplist .list div:not(.singleitem)\");\n    shopItems.forEach(function(item){\n      var text = item.textContent.toUpperCase();\n      if(text.indexOf(filter) > -1){\n        item.style.display = \"\";\n      }\n      else {\n        item.style.display = \"none\";\n      }\n    });\n  });\n</script>\n\n<div id=\"map\"></div>\n\n</div>\n\n    <script>\nvar cities = {};\n\n            // Haritayı oluştur\n            var map;\n\n            var infowindow;\n\n      var markers = [];\n        function initMap() {\n            // Başlangıç merkezi\n            var merkez = { lat: 39.245472 /* 39.925533 */, lng: 35.487361 /* 32.866287 */ }; // Ankara\n\n            // Haritayı oluştur\n            map = new google.maps.Map(document.getElementById(\"map\"), {\n                zoom: 6,\n                center: merkez,\n            });\n\nvar locations = [];\nvar locI = 0;\n\nstoreList().split(\"\\n\").forEach((data, index) => {\n\nif(\n  !isNaN(data.split(\";\")[5]) && !isNaN(data.split(\";\")[6]) && data.split(\";\")[5] && data.split(\";\")[6] && !String(data.split(\";\")[5]).includes(\"+\") && !String(data.split(\";\")[6]).includes(\"+\")\n  // ### DÜZENLENMELİ: && (data.split(\";\")[5] != 0 && data.split(\";\")[6] != 0)\n){ //  && String(location.lat).split(\".\").length == 2 && String(location.lng).split(\".\").length == 2\n\n//if(!isNaN(data.split(\";\")[5]) && !isNaN(data.split(\";\")[6])) {\nif (data.split(\";\")[4] === \"Türkiye\") { /* for hide Foreign */\n  locations.push(\n    {\n  /* lat: Number(data.split(\";\")[0]),\n  lng: Number(data.split(\";\")[1]),\n  title: data.split(\";\")[2],\n  category: data.split(\";\")[3-] // Number() */\n  lat: Number(data.split(\";\")[5]),\n  lng: Number(data.split(\";\")[6]),\n  title: data.split(\";\")[0],\n  category: data.split(\";\")[3], // Number( data.split(\";\")[3-])\n  adress: data.split(\";\")[1], // Number()\n\n  storeIndex: locI, // index\n\ndomestic: data.split(\";\")[4],\ncount: 1,\n    }\n  );\n}\n\n  var [lat, lng, cityName, cityTitle] = data.split(\";\");\n  if (!cities[data.split(\";\")[3]]) {\n    cities[data.split(\";\")[3]] = {\n      lat: 0,\n      lng: 0,\n      title: data.split(\";\")[3], // cityTitle\n      category: data.split(\";\")[4] == \"Türkiye\" ? \"Turkey\" : \"Foreign\", // data.split(\";\")[3] // cityTitle\n      count: 0,\n      stores: []\n    };\n  }\n  cities[data.split(\";\")[3]/* cityTitle */].lat += parseFloat(data.split(\";\")[5] /* lat */);\n  cities[data.split(\";\")[3]].lat = cities[data.split(\";\")[3]].lat / (cities[data.split(\";\")[3]].count == 0 ? 1 : 1.996); // 1 : 2\n  \n  cities[data.split(\";\")[3]].lng += parseFloat(data.split(\";\")[6] /* lng */);\n  cities[data.split(\";\")[3]].lng = cities[data.split(\";\")[3]].lng / (cities[data.split(\";\")[3]].count == 0 ? 1 : 2);\n  \n  cities[data.split(\";\")[3]].count += 1;\n  cities[data.split(\";\")[3]].stores.push(data.split(\";\")[0] /* cityName */);\n\n  // cities[data.split(\";\")[3]].title = cities[data.split(\";\")[3]].title + \"(\"+cities[data.split(\";\")[3]].count+\")\";\n\nif(!isNaN(cities[data.split(\";\")[3]].lat) && !isNaN(cities[data.split(\";\")[3]].lng)) {\n  if (data.split(\";\")[4] === \"Türkiye\") { /* for hide Foreign */\n  locations.push(cities[data.split(\";\")[3]]);\n  }\n}\n\nlocI += 1;\n\n}\n\n});\n\n// console.log(locations, locations2);\n\nvar mIcon = {\n  path: google.maps.SymbolPath.CIRCLE,\n  fillOpacity: 1,\n  fillColor: 'crimson',\n  strokeOpacity: 1,\n  strokeWeight: 1,\n  strokeColor: '#333',\n  // scaledSize: new google.maps.Size(18, 18)\n  scale: 8.5\n};\n\n            // Marker ekleme\n            locations.forEach(function (location) {\n// console.log(location, location.category);\n                var marker = new google.maps.Marker({\n                    position: { lat: location.lat, lng: location.lng },\n                    map: map,\n                    title: location.title,\n\n// label: String(location.count)\nlabel: {color: location.count ? '#fff' : \"#000\", fontSize: '11px' /* 12px */, fontWeight: '600',\ntext: location.count ? String(location.count) : \" \" /* location.title */},\n\nicon: mIcon\n                });\n\nmarker.category = location.category;\nmarker.domestic = location.domestic;\nif(\n  marker.category != \"Turkey\"\n  /* NEED FIX */ && marker.category != \"Foreign\"\n){\n  marker.setVisible(false); // Hide Foreign Countries\n}\nmarkers.push(marker);\n\n                // Bilgi penceresi ekleme\n                /* var */ infowindow = new google.maps.InfoWindow({\n                    content: `<h4><!-- ${location.title /* NEED FIX */} --></h4>`\n                });\n\n                marker.addListener(\"click\", function (elM) {\n\n                  if(\n                    marker.category != \"Turkey\"\n                  ){\n\n                    infowindow.open(map, marker);\n\ndocument.querySelector(\".singleitem\").innerHTML =\n  document.querySelector(\".shopitem-\" + location.storeIndex).innerHTML;\nsetTimeout(() => {\n  document.querySelector('div[role=\"dialog\"] > div > div > h4').textContent = location.title; // document.querySelector(\".shopitem-\" + location.storeIndex + \" strong\").textContent\n  // document.querySelector(\".singleitem strong\").textContent;\n}, 1);\n\ndocument.querySelectorAll('div[class^=\"shopitem-\"]').forEach(function(el){\n  el.style.display = \"none\";\n});\n\nitemInfo(location.storeIndex);\n\n                  }\n\nif(\n  marker.category != \"Turkey\"\n){\nmap.zoom = 12; // 13\n\ndocument.querySelector(\".shopclose\").style.display = \"block\";\n}else{\nmap.zoom = 9; // 10\n\n\ndocument.querySelectorAll('div[class^=\"shopitem-\"]').forEach(function(el){\n  if(el.dataset.maincategory == elM.domEvent.target.parentElement.title /* Without mIcon: elM.domEvent.target.title */ ){ // location.title\n    el.style.display = \"grid\";\n  }else{\n    el.style.display = \"none\";\n  }\n});\n\ndocument.querySelector(\".shopclose\").style.display = \"block\";\n\n}\n// map.center = { lat: marker.lat, lng: marker.lng },\n/* var initialLoc = new google.maps.LatLng(marker.lat, marker.lng);\nmap.setCenter(initialLoc); */\nmap.setCenter(new google.maps.LatLng(location.lat, location.lng), 7);\n\ndisplayM(marker.title, 1);\n                });\n            });\n        }\n\ndocument.querySelector(\".shopclose\").addEventListener(\"click\", function(){\n  document.querySelector(\".singleitem\").innerHTML = \"\";\n\n  document.querySelectorAll('div[class^=\"shopitem-\"]').forEach(function(el){\n    el.style.display = \"grid\";\n  });\n  document.querySelector(\".shopclose\").style.display = \"none\";\n  map.zoom = 6;\n  map.setCenter(new google.maps.LatLng(39.245472 /* 39.925533 */, 35.487361 /* 32.866287 */), 6);\n  displayM(\"Turkey\", 6);\n\n  infowindow.close();\n});\n\nfunction displayM(category, zoom) {\n  var i;\n\n  for (i = 0; i < markers.length; i++) {\n    if (markers[i].category === category) {\n      markers[i].setVisible(true);\n    }\n    else if(zoom != 1 || markers[i].category == \"Turkey\") {\n      markers[i].setVisible(false);\n    }\n  }\n}\n\nvar locationsList = [];\nvar locI2 = 0;\n\nstoreList().split(\"\\n\").forEach((data, index) => {\n\n  //if(!isNaN(data.split(\";\")[5]) && !isNaN(data.split(\";\")[6])) {\nif(!isNaN(data.split(\";\")[5]) && !isNaN(data.split(\";\")[6]) && data.split(\";\")[5] && data.split(\";\")[6] && !String(data.split(\";\")[5]).includes(\"+\") && !String(data.split(\";\")[6]).includes(\"+\")){ //  && String(location.lat).split(\".\").length == 2 && String(location.lng).split(\".\").length == 2\n  locationsList.push(\n    {\n  lat: Number(data.split(\";\")[5]),\n  lng: Number(data.split(\";\")[6]), // parseFloat(), Number()\n  title: data.split(\";\")[0], // 2\n/* category: data.split(\";\")[3-], */ // Number(),\n\n  adress: data.split(\";\")[1], // Number()\n\n  storeIndex: locI2, // index\n\n  maincategory: data.split(\";\")[3],\n\ncountry: data.split(\";\")[4]\n    }\n  );\n\nlocI2 += 1;\n\n}\n\n});\n\nlocI3 = 0;\n\nlocationsList.forEach(function (location, index) {\n  /*\n  if(!isNaN(location.lat) && !isNaN(location.lng) && location.lat && location.lng && !String(location.lat).includes(\"+\") && !String(location.lng).includes(\"+\")){\n  */\n  //  && String(location.lat).split(\".\").length == 2 && String(location.lng).split(\".\").length == 2\n  /* var marker = new google.maps.Marker({\n      position: { lat: Number(location.lat), lng: Number(location.lng) },\n      map: map,\n      title: location.title\n  }); */\n  // }\n\n  var shoplistDiv = document.querySelector(\".shoplist .list\");\n  var div = document.createElement(\"div\");\n  div.className = \"shopitem-\" + index;\n  div.dataset.storeIndex = index;\n  div.dataset.maincategory = location.maincategory;\n  div.dataset.location = location.lat + \",\" + location.lng;\n\n  if(location.lat && location.lat != 0){\n    div.setAttribute(\"onclick\", `displayMSingle('${location.title}', ${locI3});`);\n  }\n  \n  div.innerHTML = `<strong>${location.title}</strong> ${location.adress} ${location.maincategory} ${location.country}\n    ${(location.lat && location.lat != 0) ? `<span data-onclick=\"displayMSingle('${location.title}', ${locI3});\" style=\"cursor: pointer;\">\n  <svg style=\"width: 20px;\" fill=\"#000000\" version=\"1.1\" id=\"Capa_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" viewBox=\"0 0 416.979 416.979\" xml:space=\"preserve\"><g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"></g><g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></g><g id=\"SVGRepo_iconCarrier\"> <g> <path d=\"M356.004,61.156c-81.37-81.47-213.377-81.551-294.848-0.182c-81.47,81.371-81.552,213.379-0.181,294.85 c81.369,81.47,213.378,81.551,294.849,0.181C437.293,274.636,437.375,142.626,356.004,61.156z M237.6,340.786 c0,3.217-2.607,5.822-5.822,5.822h-46.576c-3.215,0-5.822-2.605-5.822-5.822V167.885c0-3.217,2.607-5.822,5.822-5.822h46.576 c3.215,0,5.822,2.604,5.822,5.822V340.786z M208.49,137.901c-18.618,0-33.766-15.146-33.766-33.765 c0-18.617,15.147-33.766,33.766-33.766c18.619,0,33.766,15.148,33.766,33.766C242.256,122.755,227.107,137.901,208.49,137.901z\"></path> </g> </g></svg>\n  <!-- <svg fill=\"#000000\" version=\"1.1\" id=\"Capa_1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" viewBox=\"0 0 425.963 425.963\" xml:space=\"preserve\"><g id=\"SVGRepo_bgCarrier\" stroke-width=\"0\"></g><g id=\"SVGRepo_tracerCarrier\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></g><g id=\"SVGRepo_iconCarrier\"> <g> <path d=\"M213.285,0h-0.608C139.114,0,79.268,59.826,79.268,133.361c0,48.202,21.952,111.817,65.246,189.081 c32.098,57.281,64.646,101.152,64.972,101.588c0.906,1.217,2.334,1.934,3.847,1.934c0.043,0,0.087,0,0.13-0.002 c1.561-0.043,3.002-0.842,3.868-2.143c0.321-0.486,32.637-49.287,64.517-108.976c43.03-80.563,64.848-141.624,64.848-181.482 C346.693,59.825,286.846,0,213.285,0z M274.865,136.62c0,34.124-27.761,61.884-61.885,61.884 c-34.123,0-61.884-27.761-61.884-61.884s27.761-61.884,61.884-61.884C247.104,74.736,274.865,102.497,274.865,136.62z\"></path> </g> </g></svg> -->\n  </span>`: \"\"}\n  <br>`;\n\n  shoplistDiv.append(div);\n\n  locI3 += 1;\n\n  /*\n  }\n  */\n\n});\n\nfunction displayMSingle(title, index) {\n  var i;\n  \n  document.querySelector(\"#shopclose\" /* \"#map\" */).scrollIntoView({ behavior: \"smooth\", block: \"end\", inline: \"nearest\" });\n\n  for (i = 0; i < locationsList.length; i++) {\n    if (locationsList[i].title === title) {\n      // markers[locationsList].setVisible(true);\nvar markerSingle = new google.maps.Marker({\n    position: { lat: Number(locationsList[i].lat), lng: Number(locationsList[i].lng) },\n    map: map,\n    title: locationsList[i].title,\n\n// label: \"2\",\n// label: {color: '#000', fontSize: '12px', fontWeight: '600', text: '123'},\n// icon: mIcon\n});\nmarkers.push(markerSingle);\n\nmap.zoom = 12;\n// map.center = { lat: marker.lat, lng: marker.lng },\n/* var initialLoc = new google.maps.LatLng(marker.lat, marker.lng);\nmap.setCenter(initialLoc); */\nmap.setCenter(new google.maps.LatLng(Number(locationsList[i].lat), Number(locationsList[i].lng)), 7);\n\n/* var */ infowindow = new google.maps.InfoWindow({\n  content: `<h4>${locationsList[i].title}</h4>`\n});\ninfowindow.open(map, markerSingle);\n\n    }\n    /* else if(zoom != 1 || markers[i].category == \"Turkey\") {\n      markers[i].setVisible(false);\n    } */\n  }\n\nitemInfo(index);\n\ndocument.querySelectorAll('div[class^=\"shopitem-\"]').forEach(function(el){\n  el.style.display = \"none\";\n});\ndocument.querySelector(\".shopitem-\" + index).style.display = \"grid\";\ndocument.querySelector(\".shopclose\").style.display = \"block\";\n\n}\n\nfunction itemInfo(index){\ndocument.querySelector(\".singleitem\").innerHTML =\n  document.querySelector(\".shopitem-\" + index).innerHTML +\n  `<div>\n  <a href=\"https://www.google.com/maps/dir/?api=1&destination=${document.querySelector(\".shopitem-\" + index).dataset.location}\" target=\"_blank\">\n  Yol Tarifi\n  </a>\n<div style=\"display: grid;\">\n<a href=\"https://wa.me/904448345\" target=\"_blank\">\nWhatsApp Destek: 444 83 45\n</a>\n<a href=\"tel:904448345\">\n444 83 45\n</a>\n<a href=\"mailto:info@lorisparfum.com\">\ninfo@lorisparfum.com\n</a>\n</div>\n  </div>`;\n}\n\n/* function storeList () {\n  // Mağaza İsimleri;Adres;İlçe;İl;Ülke;Enlem;Boylam\n  return `Adana Çukurova;\"Mahvesiğmaz Mahallesi, Kenan Evren Bulvarı\";-;Adana;Türkiye;37.04302337100166;35.30304004565331\nAdana Mehmet Akif Ersoy Caddesi;\"Yeşilevler Mahallesi, Mehmet Akif Ersoy Caddesi, No: 97\";-;Adana;Türkiye;37.00460576491486;35.28834178603933\nAdana Bülent Angın Bulvarı;\"Yeni Baraj Yolu, Bülent Angın Bulvarı\";-;Adana;Türkiye;37.0254356;35.3119407`;\n} */\n    </script>\n<style>\ndiv > div > div > div[class][aria-hidden=\"true\"] {\n  max-width: 100px;\n  margin: 0 auto;\n  white-space: break-spaces;\n}\n\n  .shoplist {\n    max-height: 400px;\n    height: fit-content;\n\n    display: grid;\n    align-content: flex-start;\n  }\n  .singleitem {\n    padding: 10px;\n\n    display: grid;\n  }\n  div[class^=\"shopitem-\"] {\n    margin-bottom: 10px;\n    display: grid;\n\n    border-bottom: 1px solid #0002;\n    padding-bottom: 10px;\n\n    position: relative;\n\n    cursor: pointer;\n  }\n  div[class^=\"shopitem-\"] span {\n    position: absolute;\n    top: 0;\n    right: 20px;\n  }\n  .singleitem:not(:empty) {\n    background-color: #0001;\n    color: #000;\n  }\n  .singleitem:not(:empty) ~ div {\n    display: none !important;\n  }\n\n@media (min-width: 1200px) {\n  .storelocator {\n    display: flex;\n  }\n  .shoplist {\n    width: 50%;\n    margin-right: 30px;\n    max-height: 600px;\n  }\n  .singleitem span {\n    display: none;\n  }\n  div[class^=\"shopitem-\"] {\n    padding: 0 10px 10px;\n  }\n\n  .shoplist {\n    position: relative;\n  }\n  .shoplist .shopclose {\n    /* position: absolute;\n    top: -10px;\n    right: 5px; */\n    text-align: right;\n    line-height: 1;\n    margin: 20px 0 -10px;\n  }\n\n  .shoplist .list {\n    margin-top: 15px; /* 30px */\n  }\n}\n</style>\n\n<style>\n.list {\n  font-family: var(--font-base);\n}\n.list strong {\n  font-family: var(--font-headline);\n}\n</style>\n\n<!--\n\n-->"
