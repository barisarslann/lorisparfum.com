        "custom_liquid_DzCWhM": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign discount_keywords = settings.discount_keywords | newline_to_br | split: '<br />' %}\n{% assign currentDiscounts = '|' %}\n\n<div class=\"relatedCats\">\n  <div class=\"product-special-collections\" style=\"display:flex;flex-wrap:wrap;line-height:1;margin-top:15px;gap:10px;row-gap:0;align-items:center;\">\n\n    <strong style=\"display:flex;align-items:center;gap:5px;font-size:15px;font-weight:500;\">\n      Kampanyalar :\n    </strong>\n\n    <ul style=\"list-style:none;margin:0;padding-left:0;display:flex;gap:10px;flex-wrap:wrap;\">\n\n      {% for collection in product.collections %}\n\n        {% assign collection_title = collection.title | downcase %}\n\n        {% for keyword in discount_keywords %}\n\n          {% assign keyword = keyword | strip %}\n\n          {% if keyword != blank %}\n\n            {% assign keyword_lower = keyword | downcase %}\n\n            {% if collection_title contains keyword_lower %}\n\n              {% assign unique_key = '|' | append: keyword | append: '|' %}\n\n              {% unless currentDiscounts contains unique_key %}\n\n                {% assign currentDiscounts = currentDiscounts | append: keyword | append: '|' %}\n\n                <li style=\"border:1px solid #000;padding:2px 6px;border-radius:5px;margin:0;\">\n                  <a href=\"{{ collection.url }}\" style=\"text-decoration:none;font-size:15px;\">\n                    {{ collection.title }}\n                  </a>\n                </li>\n\n              {% endunless %}\n\n            {% endif %}\n\n          {% endif %}\n\n        {% endfor %}\n\n      {% endfor %}\n\n    </ul>\n\n  </div>\n</div>\n\n{% if currentDiscounts == \"|\" %}\n<style>\n.product-special-collections{\n  display:none !important;\n}\n</style>\n{% endif %}"
