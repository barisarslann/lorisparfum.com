        "custom_liquid_tdbp8x": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% if product.available %}\n{% assign current_variant = product.selected_or_first_available_variant %}\n\n<div id=\"loris-fomo-box\" class=\"loris-fomo-container\" style=\"--fomo-color: #DBA4B4; display: flex; align-items: center; gap: 8px; margin-bottom: 15px; font-size: 14px; color: #333; background: #f9f9f9; padding: 8px 12px; border-radius: 6px; border: 1px solid #eee;\">\n  <span style=\"position: relative; display: flex; height: 10px; width: 10px; flex-shrink: 0;\">\n    <span style=\"animation: fomoPing 1.5s cubic-bezier(0, 0, 0.2, 1) infinite; position: absolute; display: inline-flex; height: 100%; width: 100%; border-radius: 50%; background-color: var(--fomo-color); opacity: 0.75; transition: background-color 0.5s ease-in-out;\"></span>\n    <span style=\"position: relative; display: inline-flex; border-radius: 50%; height: 10px; width: 10px; background-color: var(--fomo-color); transition: background-color 0.5s ease-in-out;\"></span>\n  </span>\n  <span id=\"dynamic-fomo-text\" style=\"transition: opacity 0.5s ease-in-out; opacity: 1;\">Hesaplanıyor...</span>\n</div>\n\n<style>\n  @keyframes fomoPing {\n    75%, 100% { transform: scale(2.5); opacity: 0; }\n  }\n  .loris-fomo-container strong { \n    color: var(--fomo-color); \n    font-weight: 700; \n    transition: color 0.5s ease-in-out;\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function() {\n    function getRandomInt(min, max) {\n      return Math.floor(Math.random() * (max - min + 1)) + min;\n    }\n\n    function formatNumber(num) {\n      if (num >= 1000) {\n        let formatted = (num / 1000).toFixed(1);\n        return formatted.replace('.', ',').replace(',0', '') + 'B';\n      }\n      return num;\n    }\n\n    const currentInCart = getRandomInt(150, 800);\n    const currentViews = getRandomInt(1000, 9500);\n    const currentSold = getRandomInt(500, 2500);\n    const currentFavorites = getRandomInt(5000, 15000);\n\n    // Temel mesajlar (Stok mesajı çıkarıldı)\n    const messages = [\n      `🛒 Şu an <strong>${formatNumber(currentInCart)}</strong> kişinin sepetinde!`,\n      `🚀 Popüler ürün! Son 24 saatte <strong>${formatNumber(currentViews)}</strong> kişi görüntüledi.`,\n      `🛍️ Bu hafta <strong>${formatNumber(currentSold)}+ ürün</strong> satıldı!`,\n      `❤️ <strong>${formatNumber(currentFavorites)}</strong> kişi favoriledi.`\n    ];\n\n    // GERÇEK STOK KONTROLÜ (Stok 15 ve altındaysa listeye uyarı ekler)\n    {% if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 15 %}\n      messages.push(`⏳ Sadece <strong>{{ current_variant.inventory_quantity }} adet</strong> kaldı, tükenmeden al!`);\n    {% endif %}\n\n    const colors = ['#DBA4B4', '#E1C1A2', '#91D2E5'];\n\n    for (let i = messages.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [messages[i], messages[j]] = [messages[j], messages[i]];\n    }\n\n    let currentIndex = 0;\n    let colorIndex = 0;\n    const fomoTextContainer = document.getElementById(\"dynamic-fomo-text\");\n    const fomoBox = document.getElementById(\"loris-fomo-box\");\n    \n    if (fomoTextContainer && fomoBox) {\n      fomoTextContainer.innerHTML = messages[currentIndex];\n      fomoBox.style.setProperty('--fomo-color', colors[colorIndex]);\n\n      setInterval(function() {\n        fomoTextContainer.style.opacity = '0';\n        \n        setTimeout(function() {\n          currentIndex = (currentIndex + 1) % messages.length;\n          colorIndex = (colorIndex + 1) % colors.length;\n          \n          fomoTextContainer.innerHTML = messages[currentIndex];\n          fomoBox.style.setProperty('--fomo-color', colors[colorIndex]);\n          fomoTextContainer.style.opacity = '1';\n        }, 500); \n        \n      }, 5000);\n    }\n  });\n</script>\n{% endif %}"
          }
        },
